<UserControl x:Class="RetroBar.Controls.CpuTempDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utilities="clr-namespace:RetroBar.Utilities"
             xmlns:controls="clr-namespace:RetroBar.Controls"
             Loaded="CpuTempDisplay_OnLoaded"
             Unloaded="CpuTempDisplay_OnUnloaded"
             Visibility="Collapsed">
    <Grid>
    <!-- Transparent background so the whole widget takes the pointer that opens the graph. -->
    <StackPanel x:Name="CpuTempPanel"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Margin="4,0"
                Background="Transparent"
                MouseEnter="CpuTempPanel_OnMouseEnter"
                MouseLeave="CpuTempPanel_OnMouseLeave">
        <!-- A small chip socket (a hollow body with a pin on each side, twice), in place of the "/" that used to sit here: with
             it the number reads as the processor's, not as the other half of the weather's. It sits inside this same UserControl
             (rather than as a separate element in Taskbar.xaml) so it only ever appears alongside CpuTempText - collapsing this
             whole control (no admin, no sensor) hides it with it. This is the 100% drawing, 10 by 8 pixels, each rectangle on a
             whole pixel. At 125% a DIP is 1.25 pixels, so there the CpuTempChip tag in monitor-adjustments.json gives it a
             Width/Height and a Geometry drawn in 0.8 DIP units (12 by 10 pixels), which are whole pixels again. -->
        <Path x:Name="CpuTempChip"
              Width="10"
              Height="8"
              Margin="-4,0,2,2"
              VerticalAlignment="Center"
              SnapsToDevicePixels="True"
              UseLayoutRounding="True"
              Fill="{DynamicResource ClockForeground}"
              Data="F1 M2,0 H8 V1 H2 Z M2,1 H3 V2 H2 Z M7,1 H8 V2 H7 Z M0,2 H3 V3 H0 Z M7,2 H10 V3 H7 Z M2,3 H3 V4 H2 Z M7,3 H8 V4 H7 Z M2,4 H3 V5 H2 Z M7,4 H8 V5 H7 Z M0,5 H3 V6 H0 Z M7,5 H10 V6 H7 Z M2,6 H3 V7 H2 Z M7,6 H8 V7 H7 Z M2,7 H8 V8 H2 Z"
              utilities:MonitorOffset.Tag="CpuTempChip" />
        <TextBlock x:Name="CpuTempText"
                   Style="{DynamicResource CpuTempStyle}"
                   Foreground="{DynamicResource ClockForeground}"
                   utilities:MonitorOffset.Tag="CpuTemp" />
        <controls:Sparkline x:Name="CpuGraphLine"
                            Width="24"
                            Height="10"
                            Margin="3,0,0,4"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            utilities:MonitorOffset.Tag="WidgetSparkline" />
    </StackPanel>
    <!-- The graph of the temperature of the last five minutes: opens and closes as the weather's forecast does (the same frame, the same
         slide; see CpuTempDisplay.xaml.cs). -->
    <Popup x:Name="GraphPopup"
           StaysOpen="True"
           AllowsTransparency="True"
           PopupAnimation="None">
        <!-- Text on whole pixels, hinted as the graph's own labels are (the taskbar's smoothed text would blur the line of Min, Average
             and Max, which are laid out at the middle of the width, on half pixels). -->
        <Grid x:Name="GraphFrame"
              ClipToBounds="True"
              UseLayoutRounding="True"
              SnapsToDevicePixels="True"
              TextOptions.TextFormattingMode="Display"
              RenderOptions.ClearTypeHint="Enabled">
            <Grid x:Name="GraphSlideHost">
                <controls:PopupShadow />
                <ContentControl Margin="6"
                                Style="{DynamicResource TaskButtonThumbnail}"
                                MouseEnter="GraphPopup_OnMouseEnter"
                                MouseLeave="GraphPopup_OnMouseLeave">
                    <StackPanel Margin="5.4,5.8,5.4,5.8"
                                Width="250">
                        <!-- The temperature and the name of the processor, one line: 49° · AMD Ryzen 7 5800X -->
                        <TextBlock x:Name="GraphHeader"
                                   Style="{DynamicResource GlobalFonts}"
                                   Foreground="{DynamicResource ButtonForeground}"
                                   FontFamily="Tahoma"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="2,0,2,0" />
                        <controls:CpuTempGraph x:Name="Graph"
                                               Height="108"
                                               Margin="0,9,0,0" />
                        <!-- Min, average and max across the width of the widget: the first at the left, the last at the right, the
                             second between them. -->
                        <Grid Margin="2,6,2,0">
                            <TextBlock x:Name="GraphMin"
                                       HorizontalAlignment="Left"
                                       Style="{DynamicResource GlobalFonts}"
                                       Foreground="{DynamicResource ButtonForeground}"
                                       FontFamily="Microsoft Sans Serif"
                                       FontWeight="Normal" />
                            <TextBlock x:Name="GraphAverage"
                                       HorizontalAlignment="Center"
                                       Style="{DynamicResource GlobalFonts}"
                                       Foreground="{DynamicResource ButtonForeground}"
                                       FontFamily="Microsoft Sans Serif"
                                       FontWeight="Normal" />
                            <TextBlock x:Name="GraphMax"
                                       HorizontalAlignment="Right"
                                       Style="{DynamicResource GlobalFonts}"
                                       Foreground="{DynamicResource ButtonForeground}"
                                       FontFamily="Microsoft Sans Serif"
                                       FontWeight="Normal" />
                        </Grid>
                    </StackPanel>
                </ContentControl>
            </Grid>
        </Grid>
    </Popup>
    </Grid>
</UserControl>
