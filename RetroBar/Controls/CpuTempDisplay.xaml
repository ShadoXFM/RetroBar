<UserControl x:Class="RetroBar.Controls.CpuTempDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utilities="clr-namespace:RetroBar.Utilities"
             Loaded="CpuTempDisplay_OnLoaded"
             Unloaded="CpuTempDisplay_OnUnloaded"
             Visibility="Collapsed">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,0">
        <!-- A small chip, in place of the "/" that used to sit here: with it the number reads as the processor's, not as
             the other half of the weather's. It sits inside this same UserControl (rather than as a separate element in
             Taskbar.xaml) so it only ever appears alongside CpuTempText - collapsing this whole control (no admin, no
             sensor) hides it with it. Drawn on whole DIPs (a 6 DIP body with two 1 DIP pins on each side) and snapped to
             the device pixels. CpuTempText's own colour and opacity are set in CpuTempDisplay.xaml.cs (dimmer than the
             clock, amber then red as it gets hot), and this takes the same ones. -->
        <Path x:Name="CpuTempChip"
              Width="10"
              Height="10"
              Margin="-2,0,3,2"
              VerticalAlignment="Center"
              SnapsToDevicePixels="True"
              UseLayoutRounding="True"
              Fill="{DynamicResource ClockForeground}"
              Opacity="0.7"
              Data="F0 M2,2 H8 V8 H2 Z M3,3 V7 H7 V3 Z M3,0 H4 V2 H3 Z M6,0 H7 V2 H6 Z M3,8 H4 V10 H3 Z M6,8 H7 V10 H6 Z M0,3 H2 V4 H0 Z M0,6 H2 V7 H0 Z M8,3 H10 V4 H8 Z M8,6 H10 V7 H8 Z"
              utilities:MonitorOffset.Tag="CpuTempChip" />
        <TextBlock x:Name="CpuTempText"
                   Style="{DynamicResource CpuTempStyle}"
                   Foreground="{DynamicResource ClockForeground}"
                   Opacity="0.7"
                   utilities:MonitorOffset.Tag="CpuTemp" />
    </StackPanel>
</UserControl>
