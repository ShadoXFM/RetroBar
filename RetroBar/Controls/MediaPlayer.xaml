<UserControl x:Class="RetroBar.Controls.MediaPlayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utilities="clr-namespace:RetroBar.Utilities"
             xmlns:converters="clr-namespace:RetroBar.Converters"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Visibility="Collapsed">
    <UserControl.Resources>
        <converters:SubtractDoubleConverter x:Key="subtractDoubleConverter" />
    </UserControl.Resources>
    <StackPanel Orientation="Horizontal"
                Style="{DynamicResource MediaPlayerPanelStyle}">
        <!-- Real, interactive buttons live in code (see InitializeTransportButtonAdorners in
             MediaPlayer.xaml.cs), each hosted in its own Adorner anchored to one of these
             spacers. A spacer only reserves this StackPanel slot's layout space (same Style,
             so it naturally sizes the same as the real button would) and is never itself
             shown - Visibility="Hidden" both hides it and excludes it from hit-testing/focus.
             This escapes the Tray GroupBox's own Padding/BorderThickness-driven clip (see
             Taskbar.xaml's AdornerDecorator comment) the same way MediaAlbumArt's Adorner
             already does, which a real per-monitor Margin/X shift on the button itself can't. -->
        <Button x:Name="PreviousButtonSpacer"
                Style="{DynamicResource MediaPlayerButtonStyle}"
                Visibility="Hidden">
            <Path Data="{DynamicResource MediaPlayerPreviousGeometry}"
                  Style="{DynamicResource MediaPlayerGlyphStyle}" />
        </Button>
        <Button x:Name="PlayPauseButtonSpacer"
                Style="{DynamicResource MediaPlayerButtonStyle}"
                Visibility="Hidden">
            <Path Data="{DynamicResource MediaPlayerPlayGeometry}"
                  Style="{DynamicResource MediaPlayerGlyphStyle}" />
        </Button>
        <Button x:Name="NextButtonSpacer"
                Style="{DynamicResource MediaPlayerButtonStyle}"
                Visibility="Hidden">
            <Path Data="{DynamicResource MediaPlayerNextGeometry}"
                  Style="{DynamicResource MediaPlayerGlyphStyle}" />
        </Button>
        <!-- A layout/position anchor only - always Hidden (never actually painted) when
             there's art. The visible copy lives in an Adorner (see UpdateAlbumArtAdorner
             in the code-behind) so a per-monitor MonitorAdjustments offset can push it
             outside this control's own layout bounds without the Tray GroupBox's
             Padding/BorderThickness clipping it - see Utilities/UIElementAdorner.cs. -->
        <Image x:Name="AlbumArtImage"
               Style="{DynamicResource MediaPlayerAlbumArtStyle}"
               Visibility="Collapsed"
               utilities:MonitorOffset.Tag="MediaAlbumArt" />
        <Grid x:Name="TrackTextHost"
              Style="{DynamicResource MediaPlayerTrackTextHostStyle}">
            <!-- A Canvas measures and arranges its children at their full natural
                 size, so the track text is never squeezed down to the visible
                 width. The host Grid clips it and the marquee slides it. -->
            <Canvas x:Name="TrackTextCanvas"
                    Height="{Binding ActualHeight, ElementName=TrackText}"
                    utilities:MonitorOffset.Tag="MediaTrackText"
                    Background="Transparent"
                    Cursor="Hand"
                    MouseLeftButtonUp="TrackTextCanvas_OnMouseLeftButtonUp">
                <TextBlock x:Name="TrackText"
                           Canvas.Left="0"
                           Canvas.Top="0"
                           Style="{DynamicResource MediaPlayerTrackTextStyle}"
                           SizeChanged="TrackText_SizeChanged"
                           Text="">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="TrackTextTransform" />
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Canvas>
        </Grid>

        <!-- Opens on a click on the track text (see TrackTextCanvas_OnMouseLeftButtonUp) - lets
             seeking within the current track, which doesn't fit as a permanently-visible part of
             the compact taskbar widget. StaysOpen="False" closes it on any click outside. -->
        <Popup x:Name="SeekPopup"
               PlacementTarget="{Binding ElementName=TrackTextCanvas}"
               Placement="Top"
               HorizontalOffset="-35"
               VerticalOffset="-8"
               AllowsTransparency="True"
               StaysOpen="False"
               Opened="SeekPopup_OnOpened"
               Closed="SeekPopup_OnClosed">
            <!-- Same 4-line raised bevel as a resting (non-pressed) tab (see TaskButton's own
                 template, not TaskButtonActive's sunken one): an outer DarkShadow/Highlight pair
                 around an inner Shadow/Light pair. -->
            <Border BorderThickness="0"
                    Padding="1">
                <Border BorderThickness="0,0,1,1"
                        BorderBrush="{DynamicResource ButtonDarkShadow}">
                    <Border BorderThickness="1,1,0,0"
                            BorderBrush="{DynamicResource ButtonHighlight}">
                        <Border BorderThickness="0,0,1,1"
                                BorderBrush="{DynamicResource ButtonShadow}">
                            <Border BorderThickness="1,1,0,0"
                                    BorderBrush="{DynamicResource ButtonLight}"
                                    Background="{DynamicResource ButtonFace}"
                                    Padding="2,3">
                              <StackPanel Orientation="Vertical">
                                <!-- A plain Image, not the Adorner-hosted trick MediaAlbumArt
                                     uses in the main taskbar row - that trick exists only to
                                     escape the Tray GroupBox's own Border clipping, but a Popup
                                     always renders in its own top-level surface regardless of
                                     ancestor clipping, so it isn't needed here. Kept in sync
                                     with AlbumArtImage (the real source of truth) from
                                     UpdateAlbumArt in the code-behind rather than bound directly
                                     to it, since AlbumArtImage's own Visibility means something
                                     different (Hidden = "has art, but painted via the Adorner
                                     instead") that doesn't translate 1:1 to this Image's own
                                     Visibility (Visible = "has art, paint it here"). -->
                                <!-- Sized off SeekControlsRow's own ActualWidth (the buttons+
                                     slider+time row below) rather than a fixed number, via a
                                     converter that subtracts a fixed margin instead of an actual
                                     Margin - an actual Margin here would make the image (and so
                                     this whole vertical StackPanel, which sizes to its widest
                                     child) wider than the row, which would then make the row
                                     itself wider too since it stretches to fill its container -
                                     each pushing the other wider with no stable end point. -->
                                <Image x:Name="SeekAlbumArtImage"
                                       Width="{Binding ActualWidth, ElementName=SeekControlsRow, Converter={StaticResource subtractDoubleConverter}, ConverterParameter=16}"
                                       Height="{Binding ActualWidth, ElementName=SeekControlsRow, Converter={StaticResource subtractDoubleConverter}, ConverterParameter=16}"
                                       Stretch="UniformToFill"
                                       HorizontalAlignment="Center"
                                       Margin="0,7,0,4"
                                       Visibility="Collapsed"
                                       SnapsToDevicePixels="True"
                                       UseLayoutRounding="True"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       utilities:MonitorOffset.Tag="MediaSeekAlbumArt" />
                                <TextBlock x:Name="SeekTitleText"
                                           Style="{DynamicResource MediaPlayerTrackTextStyle}"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Width="{Binding ActualWidth, ElementName=SeekControlsRow}"
                                           TextAlignment="Center"
                                           Margin="0,0,0,1"
                                           utilities:MonitorOffset.Tag="MediaSeekTitleText" />
                                <TextBlock x:Name="SeekArtistText"
                                           Style="{DynamicResource MediaPlayerTrackTextStyle}"
                                           HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Width="{Binding ActualWidth, ElementName=SeekControlsRow}"
                                           TextAlignment="Center"
                                           Margin="0,0,0,4"
                                           utilities:MonitorOffset.Tag="MediaSeekArtistText" />
                                <StackPanel x:Name="SeekControlsRow"
                                            Orientation="Horizontal">
                                    <!-- VerticalAlignment="Top" + Margin-Top=5 on the three
                                         transport buttons only (not the slider/time text) -
                                         top-aligning (instead of the style's own Center) means
                                         the 5px push grows this row's own reserved height by
                                         exactly 5px, rather than needing a separate Padding
                                         increase to avoid the buttons overflowing past it. -->
                                    <Button x:Name="SeekBackButton"
                                            Style="{DynamicResource MediaPlayerButtonStyle}"
                                            Click="SeekBackButton_OnClick"
                                            ToolTip="-10s"
                                            VerticalAlignment="Top"
                                            Margin="1,5,1,0"
                                            utilities:MonitorOffset.Tag="MediaSeekButtonBack">
                                        <!-- Same tag as the main taskbar's own previous/next
                                             glyph, so any per-monitor Geometry override applies
                                             to this popup too instead of staying its own
                                             separate (single-triangle) default shape. -->
                                        <Path Data="M 4,0 L 4,7 L 0,3.5 Z"
                                              Style="{DynamicResource MediaPlayerGlyphStyle}"
                                              utilities:MonitorOffset.Tag="MediaGlyphPrevious" />
                                    </Button>
                                    <Button x:Name="SeekPlayPauseButton"
                                            Style="{DynamicResource MediaPlayerButtonStyle}"
                                            Click="PlayPauseButton_OnClick"
                                            ToolTip="{DynamicResource media_play_pause}"
                                            VerticalAlignment="Top"
                                            Margin="1,5,1,0"
                                            utilities:MonitorOffset.Tag="MediaSeekButtonPlayPause">
                                        <Path x:Name="SeekPlayPauseGlyph"
                                              Data="{DynamicResource MediaPlayerPlayGeometry}"
                                              Style="{DynamicResource MediaPlayerGlyphStyle}"
                                              utilities:MonitorOffset.Tag="MediaGlyphPlayPause" />
                                    </Button>
                                    <Button x:Name="SeekForwardButton"
                                            Style="{DynamicResource MediaPlayerButtonStyle}"
                                            Click="SeekForwardButton_OnClick"
                                            ToolTip="+10s"
                                            VerticalAlignment="Top"
                                            Margin="1,5,1,0"
                                            utilities:MonitorOffset.Tag="MediaSeekButtonForward">
                                        <!-- Same tag as the main taskbar's own next glyph - see
                                             SeekBackButton's comment above. -->
                                        <Path Data="M 0,0 L 4,3.5 L 0,7 Z"
                                              Style="{DynamicResource MediaPlayerGlyphStyle}"
                                              utilities:MonitorOffset.Tag="MediaGlyphNext" />
                                    </Button>
                                    <Slider x:Name="SeekSlider"
                                            Style="{DynamicResource MediaSeekSliderStyle}"
                                            Width="90"
                                            Height="16"
                                            VerticalAlignment="Center"
                                            Margin="2,0"
                                            Minimum="0"
                                            Maximum="1"
                                            IsMoveToPointEnabled="True"
                                            PreviewMouseDown="SeekSlider_OnPreviewMouseDown"
                                            PreviewMouseUp="SeekSlider_OnPreviewMouseUp"
                                            utilities:MonitorOffset.Tag="MediaSeekSlider" />
                                    <TextBlock x:Name="SeekTimeText"
                                               Style="{DynamicResource MediaPlayerTrackTextStyle}"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Margin="2,0,6,0"
                                               Text="0:00 / 0:00"
                                               utilities:MonitorOffset.Tag="MediaSeekTimeText" />
                                </StackPanel>
                              </StackPanel>
                            </Border>
                        </Border>
                    </Border>
                </Border>
            </Border>
        </Popup>
    </StackPanel>
</UserControl>
