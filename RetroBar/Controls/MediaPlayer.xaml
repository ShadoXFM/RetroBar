<UserControl x:Class="RetroBar.Controls.MediaPlayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utilities="clr-namespace:RetroBar.Utilities"
             xmlns:converters="clr-namespace:RetroBar.Converters"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Visibility="Collapsed">
    <UserControl.Resources>
        <converters:SubtractDoubleConverter x:Key="subtractDoubleConverter" />
        <converters:SumWidthsConverter x:Key="sumWidthsConverter" />
        <converters:RemainingWidthConverter x:Key="remainingWidthConverter" />
        <!-- The Windows accent color for the VU-meter bars, desaturated toward gray in code (see
             UserControl_Loaded's own DesaturateAccentColor) rather than left at its full
             saturation - "less accent" turned out to mean less colorful, not more transparent.
             Opacity here is the brush's own alpha (separate from the Rectangle's own Opacity),
             kept as a distinct dial for how translucent the (now muted) color itself is. -->
        <SolidColorBrush x:Key="VuMeterAccentBrush"
                         Opacity="0.3" />
    </UserControl.Resources>
    <StackPanel Orientation="Horizontal"
                Style="{DynamicResource MediaPlayerPanelStyle}">
        <!-- A layout/position anchor only - always Hidden (never actually painted) when
             there's art. The visible copy lives in an Adorner (see UpdateAlbumArtAdorner
             in the code-behind) so a per-monitor MonitorAdjustments offset can push it
             outside this control's own layout bounds without the Tray GroupBox's
             Padding/BorderThickness clipping it - see Utilities/UIElementAdorner.cs. -->
        <Image x:Name="AlbumArtImage"
               Style="{DynamicResource MediaPlayerAlbumArtStyle}"
               Visibility="Collapsed"
               utilities:MonitorOffset.Tag="MediaAlbumArt" />
        <Grid x:Name="TrackTextHost"
              Style="{DynamicResource MediaPlayerTrackTextHostStyle}">
            <!-- The VU-meter visualizer - two stacked translucent bars (one per stereo channel)
                 behind the track text, each growing left (quiet) to right (loud).
                 Declared before TrackTextCanvas so they paint behind it. A dedicated inner Grid
                 (rather than adding RowDefinitions to TrackTextHost itself, which would also slice
                 up TrackTextCanvas - it doesn't set Grid.Row, so it'd default to just the top row)
                 splits the available height in two; HorizontalAlignment="Left" + Width set in code
                 (see VisualizerCapture_OnLevelUpdated) is what makes each bar grow from the left
                 edge rather than stretch/center. TrackTextHost's own ClipToBounds (from its Style)
                 keeps them from ever drawing past the host's own bounds regardless of how wide
                 Width gets. -->
            <Grid x:Name="VuMeterContainer"
                  VerticalAlignment="Stretch"
                  Visibility="Collapsed"
                  IsHitTestVisible="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Rectangle x:Name="VuMeterFillLeft"
                           Grid.Row="0"
                           HorizontalAlignment="Left"
                           Width="0"
                           Opacity="1"
                           Fill="{DynamicResource VuMeterAccentBrush}" />
                <Rectangle x:Name="VuMeterFillRight"
                           Grid.Row="1"
                           HorizontalAlignment="Left"
                           Width="0"
                           Opacity="1"
                           Fill="{DynamicResource VuMeterAccentBrush}" />
            </Grid>
            <!-- A Canvas measures and arranges its children at their full natural
                 size, so the track text is never squeezed down to the visible
                 width. The host Grid clips it and the marquee slides it. -->
            <Canvas x:Name="TrackTextCanvas"
                    Height="{Binding ActualHeight, ElementName=TrackText}"
                    utilities:MonitorOffset.Tag="MediaTrackText"
                    Background="Transparent"
                    Cursor="Hand"
                    MouseLeftButtonUp="TrackTextCanvas_OnMouseLeftButtonUp">
                <TextBlock x:Name="TrackText"
                           Canvas.Left="0"
                           Canvas.Top="0"
                           Style="{DynamicResource MediaPlayerTrackTextStyle}"
                           SizeChanged="TrackText_SizeChanged"
                           Text="">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="TrackTextTransform" />
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Canvas>
        </Grid>
        <!-- Real, interactive buttons live in code (see InitializeTransportButtonAdorners in
             MediaPlayer.xaml.cs), each hosted in its own Adorner anchored to one of these
             spacers. A spacer only reserves this Grid column's layout space (same Style, so it
             naturally sizes the same as the real button would) and is never itself shown -
             Visibility="Hidden" both hides it and excludes it from hit-testing/focus. This
             escapes the Tray GroupBox's own Padding/BorderThickness-driven clip (see
             Taskbar.xaml's AdornerDecorator comment) the same way MediaAlbumArt's Adorner
             already does, which a real per-monitor Margin/X shift on the button itself can't.
             The buttons are always visible now - there used to be an in-place spectrum
             visualizer here that swapped in when the mouse wasn't hovering (and, later, a
             relocated copy of it next to weather), both since removed in favor of the VU meter
             behind the track text as the only visualizer, so there's no more hover polling or
             show/hide animation tied to this area. -->
        <Grid x:Name="TransportButtonsArea"
              Background="Transparent"
              Margin="0,0,6,0"
              utilities:MonitorOffset.Tag="MediaTransportButtonsArea">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Own dedicated Margin-only tag (distinct from the real button's own
                 "MediaButtonPrevious"/etc tag) - deliberately NOT given Height/Width/X/Y, since
                 those already flow onto the spacer indirectly via the real button's own DesiredSize
                 (see AttachTransportButtonAdorner's remarks on why the spacer itself never got a
                 full tag). Margin is different: it's what sets this column's own Grid-measured
                 width, i.e. the actual pitch between adjacent buttons - the real button's own
                 Margin only resizes its rendered content within a column whose width was already
                 fixed by the spacer, so it can't close the gap on its own. -->
            <Button x:Name="PreviousButtonSpacer"
                    Grid.Column="0"
                    Style="{DynamicResource MediaPlayerButtonStyle}"
                    Visibility="Hidden"
                    utilities:MonitorOffset.Tag="MediaButtonPreviousSpacer">
                <Path Data="{DynamicResource MediaPlayerPreviousGeometry}"
                      Style="{DynamicResource MediaPlayerGlyphStyle}" />
            </Button>
            <Button x:Name="PlayPauseButtonSpacer"
                    Grid.Column="1"
                    Style="{DynamicResource MediaPlayerButtonStyle}"
                    Visibility="Hidden"
                    utilities:MonitorOffset.Tag="MediaButtonPlayPauseSpacer">
                <Path Data="{DynamicResource MediaPlayerPlayGeometry}"
                      Style="{DynamicResource MediaPlayerGlyphStyle}" />
            </Button>
            <Button x:Name="NextButtonSpacer"
                    Grid.Column="2"
                    Style="{DynamicResource MediaPlayerButtonStyle}"
                    Visibility="Hidden"
                    utilities:MonitorOffset.Tag="MediaButtonNextSpacer">
                <Path Data="{DynamicResource MediaPlayerNextGeometry}"
                      Style="{DynamicResource MediaPlayerGlyphStyle}" />
            </Button>
        </Grid>

        <!-- Opens on a click on the track text (see TrackTextCanvas_OnMouseLeftButtonUp) - lets
             seeking within the current track, which doesn't fit as a permanently-visible part of
             the compact taskbar widget. StaysOpen="False" closes it on any click outside. -->
        <Popup x:Name="SeekPopup"
               PlacementTarget="{Binding ElementName=TrackTextCanvas}"
               Placement="Top"
               HorizontalOffset="-35"
               VerticalOffset="-8"
               AllowsTransparency="True"
               StaysOpen="False"
               Opened="SeekPopup_OnOpened"
               Closed="SeekPopup_OnClosed">
            <!-- Same 4-line raised bevel as a resting (non-pressed) tab (see TaskButton's own
                 template, not TaskButtonActive's sunken one): an outer DarkShadow/Highlight pair
                 around an inner Shadow/Light pair. -->
            <Border BorderThickness="0"
                    Padding="1">
                <Border BorderThickness="0,0,1,1"
                        BorderBrush="{DynamicResource ButtonDarkShadow}">
                    <Border BorderThickness="1,1,0,0"
                            BorderBrush="{DynamicResource ButtonHighlight}">
                        <Border BorderThickness="0,0,1,1"
                                BorderBrush="{DynamicResource ButtonShadow}">
                            <Border BorderThickness="1,1,0,0"
                                    BorderBrush="{DynamicResource ButtonLight}"
                                    Background="{DynamicResource ButtonFace}"
                                    Padding="2,3">
                              <StackPanel Orientation="Vertical">
                                <!-- Plain Image with Stretch="Uniform" (fit the whole image, no
                                     cropping) - unlike UniformToFill, Uniform never crops, so it
                                     doesn't have the off-center-crop problem that made the main
                                     taskbar row's own album art (and this popup's own art, until
                                     just now) need the Rectangle+ImageBrush workaround; the whole
                                     source image is always visible here, just fit within bounds.
                                     Only Height is constrained (see below) - Width is left Auto,
                                     so non-square sources (e.g. a widescreen video-frame
                                     thumbnail) render at their own true aspect ratio instead of
                                     being forced into a square box. Kept in sync with
                                     AlbumArtImage (the real source of truth) from UpdateAlbumArt
                                     in the code-behind rather than bound directly to it, since
                                     AlbumArtImage's own Visibility means something different
                                     (Hidden = "has art, but painted via the Adorner instead")
                                     that doesn't translate 1:1 to this Image's own Visibility
                                     (Visible = "has art, paint it here"). -->
                                <!-- Height sized off the row's own FIXED-width elements only -
                                     the three transport buttons and the time text, deliberately
                                     EXCLUDING SeekSlider - plus a constant (92) standing in for
                                     their combined Margins and the slider's own baseline (90px)
                                     width, reproducing exactly what a plain
                                     SeekControlsRow.ActualWidth reference used to compute back
                                     when the slider was a fixed 90px. Excluding the slider here
                                     is deliberate: SeekSlider's own Width (below) is derived FROM
                                     this Image's ActualWidth, so if this Height also depended on
                                     the slider's width, the two would feed each other in a loop
                                     that only ever grows and never settles - see
                                     RemainingWidthConverter's own remarks. This keeps Height
                                     constant regardless of the art's own aspect ratio, so square
                                     (1:1) art renders exactly as wide as it is tall (filling the
                                     row minus its margin) while wider art (e.g. a 16:9 thumbnail)
                                     renders at the same height but wider, growing this whole
                                     vertical StackPanel (which sizes to its widest child) - and so
                                     the popup itself - to fit. -->
                                <Image x:Name="SeekAlbumArtImage"
                                       MaxHeight="280"
                                       MaxWidth="500"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       Margin="8,7,8,4"
                                       Visibility="Collapsed"
                                       SnapsToDevicePixels="True"
                                       UseLayoutRounding="True"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       utilities:MonitorOffset.Tag="MediaSeekAlbumArt">
                                    <Image.Height>
                                        <MultiBinding Converter="{StaticResource sumWidthsConverter}" ConverterParameter="92">
                                            <Binding ElementName="SeekBackButton" Path="ActualWidth" />
                                            <Binding ElementName="SeekPlayPauseButton" Path="ActualWidth" />
                                            <Binding ElementName="SeekForwardButton" Path="ActualWidth" />
                                            <Binding ElementName="SeekTimeText" Path="ActualWidth" />
                                        </MultiBinding>
                                    </Image.Height>
                                </Image>
                                <TextBlock x:Name="SeekTitleText"
                                           Style="{DynamicResource MediaPlayerTrackTextStyle}"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Width="{Binding ActualWidth, ElementName=SeekControlsRow}"
                                           TextAlignment="Center"
                                           Margin="0,0,0,1"
                                           utilities:MonitorOffset.Tag="MediaSeekTitleText" />
                                <TextBlock x:Name="SeekArtistText"
                                           Style="{DynamicResource MediaPlayerTrackTextStyle}"
                                           HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Width="{Binding ActualWidth, ElementName=SeekControlsRow}"
                                           TextAlignment="Center"
                                           Margin="0,0,0,4"
                                           utilities:MonitorOffset.Tag="MediaSeekArtistText" />
                                <!-- HorizontalAlignment="Center" (instead of the StackPanel-child
                                     default of Stretch) matters for more than just centering: the
                                     album art's Height above is bound to this row's own
                                     ActualWidth, so if this row were left to stretch to match a
                                     wide 16:9 art's width, its ActualWidth would report that wide
                                     value right back - a circular feedback loop where wide art
                                     begets a wide row begets wider art, which never settles back
                                     down on its own (not even across closing and reopening the
                                     popup, since ActualWidth is a persisted property on this same
                                     element instance either way). Centering keeps this row's own
                                     ActualWidth equal to its own intrinsic content width - the
                                     buttons+slider+time - regardless of how wide its siblings
                                     get. -->
                                <StackPanel x:Name="SeekControlsRow"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <!-- VerticalAlignment="Top" + Margin-Top=5 on the three
                                         transport buttons only (not the slider/time text) -
                                         top-aligning (instead of the style's own Center) means
                                         the 5px push grows this row's own reserved height by
                                         exactly 5px, rather than needing a separate Padding
                                         increase to avoid the buttons overflowing past it. -->
                                    <Button x:Name="SeekBackButton"
                                            Style="{DynamicResource MediaPlayerButtonStyle}"
                                            Click="SeekBackButton_OnClick"
                                            ToolTip="-10s"
                                            VerticalAlignment="Top"
                                            Margin="1,5,1,0"
                                            utilities:MonitorOffset.Tag="MediaSeekButtonBack">
                                        <!-- Own dedicated tag, deliberately NOT shared with the
                                             main taskbar row's own "MediaGlyphPrevious" (see
                                             SeekForwardButton's comment below for why). Two
                                             left-pointing triangles ("<<"), same shape as the
                                             original (pre-skip-icon) MediaPlayerPreviousGeometry
                                             in System.xaml. -->
                                        <Path Data="M 4,0 L 4,7 L 0,3.5 Z M 9,0 L 9,7 L 5,3.5 Z"
                                              Style="{DynamicResource MediaPlayerGlyphStyle}"
                                              utilities:MonitorOffset.Tag="MediaSeekGlyphPrevious" />
                                    </Button>
                                    <Button x:Name="SeekPlayPauseButton"
                                            Style="{DynamicResource MediaPlayerButtonStyle}"
                                            Click="PlayPauseButton_OnClick"
                                            ToolTip="{DynamicResource media_play_pause}"
                                            VerticalAlignment="Top"
                                            Margin="1,5,1,0"
                                            utilities:MonitorOffset.Tag="MediaSeekButtonPlayPause">
                                        <Path x:Name="SeekPlayPauseGlyph"
                                              Data="{DynamicResource MediaPlayerPlayGeometry}"
                                              Style="{DynamicResource MediaPlayerGlyphStyle}"
                                              utilities:MonitorOffset.Tag="MediaGlyphPlayPause" />
                                    </Button>
                                    <Button x:Name="SeekForwardButton"
                                            Style="{DynamicResource MediaPlayerButtonStyle}"
                                            Click="SeekForwardButton_OnClick"
                                            ToolTip="+10s"
                                            VerticalAlignment="Top"
                                            Margin="1,5,1,0"
                                            utilities:MonitorOffset.Tag="MediaSeekButtonForward">
                                        <!-- Own dedicated tag, not shared with the main row's
                                             "MediaGlyphNext" - a per-monitor Geometry override
                                             tuned for that shared tag would otherwise silently
                                             overwrite this popup's own glyph too (this is what
                                             DISPLAY1 was doing before). Two right-pointing
                                             triangles (">>"), same shape as the original
                                             (pre-skip-icon) MediaPlayerNextGeometry in
                                             System.xaml. -->
                                        <Path Data="M 0,0 L 4,3.5 L 0,7 Z M 5,0 L 9,3.5 L 5,7 Z"
                                              Style="{DynamicResource MediaPlayerGlyphStyle}"
                                              utilities:MonitorOffset.Tag="MediaSeekGlyphNext" />
                                    </Button>
                                    <!-- Width fills whatever space is left over after the other
                                         (fixed-width) siblings within the album art's own
                                         rendered width (see RemainingWidthConverter's remarks on
                                         why that's the safe direction for this dependency to run
                                         in) - 90px is both the deduction's own baseline (matching
                                         SeekAlbumArtImage.Height's ConverterParameter above) and
                                         the floor this never shrinks below. A per-monitor
                                         MediaSeekSlider Width override would otherwise permanently
                                         replace this MultiBinding outright the moment
                                         MonitorOffset applies it (a plain SetValue clears any
                                         existing Binding) - use X to nudge this slider's position
                                         instead, same as usual. -->
                                    <Slider x:Name="SeekSlider"
                                            Style="{DynamicResource MediaSeekSliderStyle}"
                                            Height="16"
                                            VerticalAlignment="Center"
                                            Margin="2,0"
                                            Minimum="0"
                                            Maximum="1"
                                            IsMoveToPointEnabled="True"
                                            PreviewMouseDown="SeekSlider_OnPreviewMouseDown"
                                            PreviewMouseUp="SeekSlider_OnPreviewMouseUp"
                                            utilities:MonitorOffset.Tag="MediaSeekSlider">
                                        <Slider.Width>
                                            <MultiBinding Converter="{StaticResource remainingWidthConverter}" ConverterParameter="18,90">
                                                <Binding ElementName="SeekAlbumArtImage" Path="ActualWidth" />
                                                <Binding ElementName="SeekBackButton" Path="ActualWidth" />
                                                <Binding ElementName="SeekPlayPauseButton" Path="ActualWidth" />
                                                <Binding ElementName="SeekForwardButton" Path="ActualWidth" />
                                                <Binding ElementName="SeekTimeText" Path="ActualWidth" />
                                            </MultiBinding>
                                        </Slider.Width>
                                    </Slider>
                                    <TextBlock x:Name="SeekTimeText"
                                               Style="{DynamicResource MediaPlayerTrackTextStyle}"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Margin="2,0,6,0"
                                               Text="0:00 / 0:00"
                                               utilities:MonitorOffset.Tag="MediaSeekTimeText" />
                                </StackPanel>
                              </StackPanel>
                            </Border>
                        </Border>
                    </Border>
                </Border>
            </Border>
        </Popup>
    </StackPanel>
</UserControl>
