<UserControl x:Class="RetroBar.Controls.WeatherDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utilities="clr-namespace:RetroBar.Utilities"
             xmlns:converters="clr-namespace:RetroBar.Converters"
             xmlns:controls="clr-namespace:RetroBar.Controls">
    <UserControl.Resources>
        <converters:CpuTempShownToMonitorTagConverter x:Key="cpuTempShownToMonitorTagConverter" />
    </UserControl.Resources>
    <Grid>
    <!-- Transparent background so the whole widget (not just its icon and text) takes the click that
         opens the forecast. -->
    <StackPanel x:Name="WeatherPanel" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,0"
                Background="Transparent"
                MouseEnter="WeatherPanel_OnMouseEnter"
                MouseLeave="WeatherPanel_OnMouseLeave"
                utilities:MonitorOffset.Tag="WeatherPanel">
        <!-- Weather Icon (sizes itself using the theme style). A Rectangle masked to the icon's
             own shape via OpacityMask, rather than a plain Image - lets the icon be tinted to
             match the theme's foreground color at render time instead of needing a
             separately-colored bitmap per theme. -->
        <!-- MonitorOffset.Tag is WeatherIcon/WeatherTemp normally, WeatherIconNoCpuTemp/
             WeatherTempNoCpuTemp while Taskbar.IsCpuTempShown is false - lets weather's own
             position be tuned differently for when there's no CPU temp display next to it (see
             CpuTempDisplay.xaml.cs, which sets IsCpuTempShown). Same pattern TrayBoxBevel uses
             for its own media-playing-state tag. -->
        <Rectangle Fill="{DynamicResource ClockForeground}"
                   Style="{DynamicResource WeatherIconStyle}"
                   utilities:MonitorOffset.Tag="{Binding Path=IsCpuTempShown, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}, Converter={StaticResource cpuTempShownToMonitorTagConverter}, ConverterParameter=WeatherIcon}">
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="{Binding WeatherBarIconPath}" Stretch="Uniform" />
            </Rectangle.OpacityMask>
        </Rectangle>
        <TextBlock Text="{Binding WeatherBarTemp}"
           Style="{DynamicResource WeatherTempStyle}"
           Foreground="{DynamicResource ClockForeground}"
           utilities:MonitorOffset.Tag="{Binding Path=IsCpuTempShown, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}, Converter={StaticResource cpuTempShownToMonitorTagConverter}, ConverterParameter=WeatherTemp}" />
    </StackPanel>
    <!-- The forecast: opens when the pointer rests on the widget and closes shortly after it leaves both
         the widget and the popup (see WeatherPanel_OnMouseEnter / ScheduleForecastClose). Uses the
         same bevelled frame as the taskbar's window previews. -->
    <Popup x:Name="ForecastPopup"
           StaysOpen="True"
           AllowsTransparency="True"
           PopupAnimation="None">
        <!-- ForecastFrame is the whole thing - shadow and frame - so fading it fades both. The shadow is its
             own element behind the frame, not an Effect on the frame (which redraws everything inside it into
             an offscreen bitmap and made the text and icons blurry); the frame has 6 of margin plus its style's
             4 all round, and 6 of that is the room the shadow spreads into (see PlaceForecast). -->
        <Grid x:Name="ForecastFrame"
              RenderOptions.ClearTypeHint="Enabled">
            <controls:PopupShadow />
            <ContentControl Margin="6"
                            Style="{DynamicResource TaskButtonThumbnail}"
                            MouseEnter="ForecastPopup_OnMouseEnter"
                            MouseLeave="ForecastPopup_OnMouseLeave">
                <StackPanel>
                    <!-- Top: "Perpignan, France" + the country's flag, with the current temperature (bold)
                         beneath it on the left, and the weather icon large on the right across both lines. -->
                    <Grid Margin="2,0,2,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding FlagSource}"
                                       Height="12"
                                       Margin="0,1,6,0"
                                       VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="{Binding LocationTitle}"
                                           Style="{DynamicResource GlobalFonts}"
                                           Foreground="{DynamicResource ButtonForeground}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding WeatherTemp}"
                                       Style="{DynamicResource GlobalFonts}"
                                       Foreground="{DynamicResource ButtonForeground}"
                                       FontWeight="Bold"
                                       FontSize="20"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                        <Rectangle Grid.Column="1"
                                   Width="44"
                                   Height="44"
                                   Margin="12,0,-2,0"
                                   Fill="{DynamicResource ButtonForeground}"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="{Binding WeatherIconPath}" Stretch="Uniform" />
                            </Rectangle.OpacityMask>
                        </Rectangle>
                    </Grid>
                    <!-- Etched separator between the current conditions and the forecast: a shadow line over a
                         highlight line, in the theme's own colors. -->
                    <StackPanel Margin="0,0,0,6"
                                UseLayoutRounding="True"
                                SnapsToDevicePixels="True">
                        <Rectangle Height="1"
                                   Fill="{DynamicResource ButtonShadow}" />
                        <Rectangle Height="1"
                                   Fill="{DynamicResource ButtonHighlight}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Forecast}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,1">
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding Range}"
                                               Style="{DynamicResource GlobalFonts}"
                                               Foreground="{DynamicResource ButtonForeground}"
                                               FontFamily="Tahoma"
                                               FontWeight="Bold"
                                               TextAlignment="Right"
                                               MinWidth="54"
                                               Margin="4,0,2,0"
                                               VerticalAlignment="Center" />
                                    <Rectangle DockPanel.Dock="Right"
                                               Width="20"
                                               Height="20"
                                               Fill="{DynamicResource ButtonForeground}"
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality">
                                        <Rectangle.OpacityMask>
                                            <ImageBrush ImageSource="{Binding IconPath}" Stretch="Uniform" />
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                    <TextBlock x:Name="DayNameText"
                                               Text="{Binding DayName}"
                                               Style="{DynamicResource GlobalFonts}"
                                               Foreground="{DynamicResource ButtonForeground}"
                                               Margin="2,0,8,0"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                                <DataTemplate.Triggers>
                                    <!-- Today's row is the bold one. -->
                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                        <Setter TargetName="DayNameText" Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ContentControl>
        </Grid>
    </Popup>
    </Grid>
</UserControl>
