<UserControl x:Class="RetroBar.Controls.StartButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utilities="clr-namespace:RetroBar.Utilities"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">
    <ToggleButton ToolTip="{DynamicResource StartButtonTip}"
                  Click="Start_OnClick"
                  DragEnter="Start_DragEnter"
                  DragLeave="Start_DragLeave"
                  PreviewMouseLeftButtonDown="Start_OnPreviewMouseLeftButtonDown"
                  MouseRightButtonUp="Start_OnMouseRightButtonUp"
                  Name="Start"
                  Style="{DynamicResource StartButton}"
                  utilities:HitAreaExtension.Enabled="True"
                  utilities:MonitorOffset.Tag="StartButtonBox">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- The logo is moved by a transform of its host (see StartButton.xaml.cs), which does not touch the layout: a margin that made it
                 wider than its place in the square button had its edge cut. -->
            <Grid x:Name="StartLogoHost"
                  Grid.Column="0">
                <Image x:Name="StartLogo"
                       Style="{DynamicResource StartIcon}"
                       utilities:MonitorOffset.Tag="StartIcon" />
            </Grid>
            <TextBlock x:Name="StartLabelText"
                       Grid.Column="1"
                       Style="{DynamicResource StartLabel}"
                       utilities:MonitorOffset.Tag="StartLabel" />
        </Grid>
    </ToggleButton>
</UserControl>
