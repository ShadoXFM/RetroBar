<UserControl x:Class="RetroBar.Controls.TaskButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:RetroBar.Converters"
             xmlns:controls="clr-namespace:RetroBar.Controls"
             xmlns:utilities="clr-namespace:RetroBar.Utilities"
             Loaded="TaskButton_OnLoaded"
             Unloaded="TaskButton_OnUnloaded">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="boolToVisibilityConverter" />
        <converters:ToolTipHorizontalOffsetConverter x:Key="toolTipHorizontalOffsetConverter" />
        <converters:ToolTipVerticalOffsetConverter x:Key="toolTipVerticalOffsetConverter" />
        <converters:ToolTipPlacementConverter x:Key="toolTipPlacementConverter" />
        <converters:TaskLabelConverter x:Key="taskLabelConverter" />
        <converters:TaskStateToMonitorTagConverter x:Key="taskStateToMonitorTagConverter" />
    </UserControl.Resources>
    <!-- MonitorOffset.Tag is TaskButton normally, TaskButtonActive while State==Active (or the
         context menu is open) - same conditional-tag pattern as TaskIcon/TaskLabel below, so the
         whole tab's own X/Y/Width/Height/Margin/etc. become per-monitor tunable too, not just
         its icon/label content. This tag and the icon/label ones depend on two inputs (State and
         the context menu), which takes a MultiBinding: set in TaskButton.xaml.cs (SetMonitorTags),
         since an element with child content can't take a property-element tag in XAML. -->
    <Button Name="AppButton"
            Click="AppButton_OnClick"
            MouseUp="AppButton_OnMouseUp"
            MouseWheel="AppButton_OnMouseWheel"
            PreviewMouseDown="AppButton_OnPreviewMouseDown"
            ContextMenuOpening="AppButton_OnContextMenuOpening"
            DragEnter="AppButton_OnDragEnter"
            DragLeave="AppButton_OnDragLeave"
            ToolTipService.ShowDuration="60000">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- MonitorOffset.Tag is TaskIcon normally, TaskIconActive while State==Active - see
                 TaskStateToMonitorTagConverter for why the active state needs its own tag. -->
            <Image x:Name="TaskIconImage"
                   Source="{Binding Path=Icon, Mode=OneWay}"
                   Grid.Column="0"
                   Style="{DynamicResource TaskIcon}" />
            <!-- MonitorOffset.Tag is TaskOverlayIcon normally, TaskOverlayIconActive while
                 State==Active - see TaskStateToMonitorTagConverter for why the active state
                 needs its own tag. -->
            <Image x:Name="TaskOverlayIconImage"
                   Source="{Binding Path=OverlayIcon, Mode=OneWay}"
                   Grid.Column="0"
                   Style="{DynamicResource TaskOverlayIcon}"
                   Visibility="{Binding Source={x:Static utilities:Settings.Instance}, Path=ShowTaskBadges, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource boolToVisibilityConverter}}" />
            <!-- MonitorOffset.Tag is TaskLabel normally, TaskLabelActive while State==Active -
                 see TaskStateToMonitorTagConverter for why the active state needs its own tag. -->
            <TextBlock x:Name="TaskLabelText"
                       Grid.Column="1"
                       Style="{DynamicResource TaskLabel}">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource taskLabelConverter}">
                        <Binding Path="Title" />
                        <Binding Path="ProgressValue" />
                        <Binding Path="ProgressState" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </Grid>
        <Button.ContextMenu>
            <ContextMenu Opened="ContextMenu_OpenedOrClosed"
                         Closed="ContextMenu_OpenedOrClosed">
                <TextOptions.TextRenderingMode>
                    <Binding Source="{x:Static utilities:Settings.Instance}" Path="AllowFontSmoothingMenu" Converter="{StaticResource menuTextRenderingModeConverter}" />
                </TextOptions.TextRenderingMode>
                <MenuItem Header="{DynamicResource restore}"
                          Click="RestoreMenuItem_OnClick"
                          Name="RestoreMenuItem">
                    <MenuItem.Icon>
                        <TextBlock FontFamily="Marlett"
                                   Text="&#x32;"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{DynamicResource move}"
                          Click="MoveMenuItem_OnClick"
                          Name="MoveMenuItem" />
                <MenuItem Header="{DynamicResource size}"
                          Click="SizeMenuItem_OnClick"
                          Name="SizeMenuItem" />
                <MenuItem Header="{DynamicResource minimize}"
                          Click="MinimizeMenuItem_OnClick"
                          Name="MinimizeMenuItem">
                    <MenuItem.Icon>
                        <TextBlock FontFamily="Marlett"
                                   Text="&#x30;"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{DynamicResource maximize}"
                          Click="MaximizeMenuItem_OnClick"
                          Name="MaximizeMenuItem">
                    <MenuItem.Icon>
                        <TextBlock FontFamily="Marlett"
                                   Text="&#x31;"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{DynamicResource end_task}"
                          Click="EndTaskMenuItem_OnClick"
                          Name="EndTaskMenuItem"
                          Visibility="{Binding Source={x:Static utilities:Settings.Instance}, Path=ShowEndTaskButton, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource boolToVisibilityConverter}}">
                </MenuItem>
                <MenuItem Header="{DynamicResource close}"
                          Click="CloseMenuItem_OnClick"
                          Name="CloseMenuItem">
                    <MenuItem.Icon>
                        <TextBlock FontFamily="Marlett"
                                   Text="&#x72;"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
        </Button.ContextMenu>
        <Button.ToolTip>
            <ToolTip>
                <ToolTip.Style>
                    <Style TargetType="ToolTip"
                           BasedOn="{StaticResource {x:Type ToolTip}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Source={x:Static utilities:Settings.Instance}, Path=ShowTaskThumbnails, UpdateSourceTrigger=PropertyChanged}"
                                                             Value="True">
                                <DataTrigger.Setters>
                                    <Setter Property="HorizontalOffset">
                                        <Setter.Value>
                                            <MultiBinding Converter="{StaticResource toolTipHorizontalOffsetConverter}" UpdateSourceTrigger="PropertyChanged">
                                                <Binding RelativeSource="{RelativeSource Self}" Path="PlacementTarget.ActualWidth"/>
                                                <Binding RelativeSource="{RelativeSource Self}" Path="ActualWidth"/>
                                                <Binding Source="{x:Static utilities:Settings.Instance}" Path="TaskbarScale"/>
                                                <Binding Source="{x:Static utilities:Settings.Instance}" Path="Edge"/>
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="VerticalOffset">
                                        <Setter.Value>
                                            <MultiBinding Converter="{StaticResource toolTipVerticalOffsetConverter}" UpdateSourceTrigger="PropertyChanged">
                                                <Binding RelativeSource="{RelativeSource Self}" Path="PlacementTarget.ActualHeight"/>
                                                <Binding RelativeSource="{RelativeSource Self}" Path="ActualHeight"/>
                                                <Binding Source="{x:Static utilities:Settings.Instance}" Path="TaskbarScale"/>
                                                <Binding Source="{x:Static utilities:Settings.Instance}" Path="Edge"/>
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Placement">
                                        <Setter.Value>
                                            <MultiBinding Converter="{StaticResource toolTipPlacementConverter}" UpdateSourceTrigger="PropertyChanged">
                                                <Binding Source="{x:Static utilities:Settings.Instance}" Path="Edge"/>
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToolTip">
                                                <!-- The close button's visibility/hover and the preview's
                                                     click-to-activate are driven from TaskButton.Preview.cs
                                                     (WPF never routes mouse input to this window). The title row exists
                                                     for the close button: the thumbnail itself is drawn by
                                                     DWM on top of the window, so anything WPF put over it
                                                     would be hidden. -->
                                                <Grid x:Name="PreviewRoot"
                                                      Background="Transparent">
                                                    <ContentControl Style="{DynamicResource TaskButtonThumbnail}">
                                                        <StackPanel>
                                                            <!-- Exactly as wide as the thumbnail below, so a long title is trimmed
                                                                 instead of widening the whole preview. -->
                                                            <!-- MonitorOffset.Tag: PreviewTitleRow - its Margin (the gap between the title/close
                                                                 button row and the thumbnail) is tunable per monitor in monitor-adjustments.json. -->
                                                            <Grid Margin="0,0,0,3"
                                                                  utilities:MonitorOffset.Tag="PreviewTitleRow"
                                                                  Width="{Binding ElementName=PreviewThumbnail, Path=Width}">
                                                                <TextBlock Text="{Binding Path=Title}"
                                                                           Foreground="{DynamicResource ButtonForeground}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Center"
                                                                           Margin="1,0,22,0" />
                                                                <Button x:Name="PreviewCloseButton"
                                                                        Style="{DynamicResource TaskPreviewCloseButton}"
                                                                        HorizontalAlignment="Right"
                                                                        VerticalAlignment="Center" />
                                                            </Grid>
                                                            <!-- BoxWidth: the thumbnail area is as wide as the tab itself, so every
                                                                 preview is the same size rather than shaped like its window. -->
                                                            <controls:TaskThumbnail x:Name="PreviewThumbnail"
                                                                                    SourceWindowHandle="{Binding Path=Handle}"
                                                                                    Title="{Binding Path=Title}"
                                                                                    BoxWidth="{Binding Path=PlacementTarget.ActualWidth, RelativeSource={RelativeSource AncestorType=ToolTip}}"/>
                                                        </StackPanel>
                                                    </ContentControl>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger.Setters>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ToolTip.Style>
                <TextBlock Text="{Binding Path=Title}" />
            </ToolTip>
        </Button.ToolTip>
    </Button>
</UserControl>
