<UserControl x:Class="RetroBar.Controls.NotificationsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utilities="clr-namespace:RetroBar.Utilities"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <!-- The notifications Windows keeps (see NotificationHistory): the popup above the calendar's. -->
    <StackPanel Width="200" Margin="4,2,4,0"
                Effect="{DynamicResource PopupContentShadow}">
        <Grid Margin="2,0,2,4">
            <TextBlock Text="{DynamicResource clock_flyout_notifications}" FontSize="12" VerticalAlignment="Center"
                       Foreground="{DynamicResource ButtonForeground}" FontFamily="{DynamicResource WidgetBoldFontFamily}"
                       FontWeight="{DynamicResource WidgetFontWeight}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- "Clear all": text that lights up under the pointer. -->
                <TextBlock x:Name="ClearAll" Cursor="Hand" Background="Transparent" Text="{DynamicResource clock_flyout_clear_all}" FontSize="11" VerticalAlignment="Center"
                           Opacity="0.7" Foreground="{DynamicResource ButtonForeground}" FontFamily="{DynamicResource WidgetLabelFontFamily}"
                           MouseEnter="ClearAll_OnMouseEnter" MouseLeave="ClearAll_OnMouseLeave" MouseLeftButtonUp="ClearAll_OnMouseLeftButtonUp" />
            </StackPanel>
        </Grid>
        <utilities:MenuSeparatorLine Margin="0,0,0,2" />
        <!-- The list is cut to its own height, which is what is animated when it is opened up or closed. -->
        <!-- Where a list is built to be measured (its height, for the animation): in the tree, so that it is measured as it will be (the lines are
             of whole pixels of the monitor's scale), and with no size, so it takes no room. -->
        <Canvas x:Name="ProbeHost" Width="0" Height="0" ClipToBounds="True" Visibility="Hidden" IsHitTestVisible="False" />
        <Border x:Name="ListHost" ClipToBounds="True">
            <StackPanel x:Name="NotificationList" />
        </Border>
        <TextBlock x:Name="NoNotifications" Text="{DynamicResource clock_flyout_no_notifications}" FontSize="11" Opacity="0.6" HorizontalAlignment="Center"
                   Margin="0,6,0,4" Foreground="{DynamicResource ButtonForeground}" FontFamily="{DynamicResource WidgetLabelFontFamily}" />
    </StackPanel>
</UserControl>
