<UserControl x:Class="RetroBar.Controls.RamDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utilities="clr-namespace:RetroBar.Utilities"
             xmlns:controls="clr-namespace:RetroBar.Controls"
             Loaded="RamDisplay_OnLoaded"
             Unloaded="RamDisplay_OnUnloaded"
             Visibility="Collapsed">
    <Grid MouseEnter="RamPanel_OnMouseEnter" MouseLeave="RamPanel_OnMouseLeave">
        <!-- The pointer's area: the widget's own width and the bar's height (reaching past the widget's box, top and bottom, which takes
             no room), so it is easy to hover. The mouse handlers are on the grid, so the area and the widget are one for them. -->
        <Border Background="Transparent" Margin="0,-24" />
    <!-- Transparent background so the whole widget takes the pointer that opens the graph. -->
    <StackPanel x:Name="RamPanel"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Margin="4,0"
                Background="Transparent">
        <!-- A square memory chip (a body with a die in the middle and pins on the top and the bottom), so the number reads as the
             memory's. It sits inside this same UserControl so it only ever appears alongside RamText. This is the 100% drawing, 9 by
             9 pixels, each rectangle on a whole pixel. At 125% a DIP is 1.25 pixels, so there the RamChip tag in
             monitor-adjustments.json gives it a Width/Height and a Geometry drawn in 0.8 DIP units (11 by 11 pixels), which are
             whole pixels again. -->
        <Path x:Name="RamChip"
              Width="9"
              Height="9"
              Margin="-4,0,2,2"
              VerticalAlignment="Center"
              SnapsToDevicePixels="True"
              UseLayoutRounding="True"
              Fill="{DynamicResource ClockForeground}"
              Data="F1 M1,0 H2 V1 H1 Z M3,0 H4 V1 H3 Z M5,0 H6 V1 H5 Z M7,0 H8 V1 H7 Z M0,1 H9 V2 H0 Z M0,2 H1 V3 H0 Z M8,2 H9 V3 H8 Z M0,3 H1 V4 H0 Z M3,3 H6 V4 H3 Z M8,3 H9 V4 H8 Z M0,4 H1 V5 H0 Z M3,4 H6 V5 H3 Z M8,4 H9 V5 H8 Z M0,5 H1 V6 H0 Z M3,5 H6 V6 H3 Z M8,5 H9 V6 H8 Z M0,6 H1 V7 H0 Z M8,6 H9 V7 H8 Z M0,7 H9 V8 H0 Z M1,8 H2 V9 H1 Z M3,8 H4 V9 H3 Z M5,8 H6 V9 H5 Z M7,8 H8 V9 H7 Z"
              utilities:MonitorOffset.Tag="RamChip" />
        <TextBlock x:Name="RamText"
                   Style="{DynamicResource CpuTempStyle}"
                   Foreground="{DynamicResource ClockForeground}"
                   utilities:MonitorOffset.Tag="RamText" />
        <controls:Sparkline x:Name="RamGraphLine"
                            Width="24"
                            Height="10"
                            Margin="3,0,2,2"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            utilities:MonitorOffset.Tag="WidgetSparkline" />
    </StackPanel>
    <!-- The graph of the memory in use over the last five minutes: opens and closes as the weather's forecast does (the same frame, the same
         slide; see RamDisplay.xaml.cs). -->
    <Popup x:Name="GraphPopup"
           StaysOpen="True"
           AllowsTransparency="True"
           PopupAnimation="None">
        <!-- Text on whole pixels, hinted as the graph's own labels are (the taskbar's smoothed text would blur the line of Min, Average
             and Max, which are laid out at the middle of the width, on half pixels). -->
        <Grid x:Name="GraphFrame"
              ClipToBounds="True"
              UseLayoutRounding="True"
              SnapsToDevicePixels="True"
              TextOptions.TextFormattingMode="Display"
              RenderOptions.ClearTypeHint="Enabled">
            <Grid x:Name="GraphSlideHost">
                <controls:PopupShadow />
                <ContentControl x:Name="GraphContent" Margin="6"
                                Style="{DynamicResource TaskButtonThumbnail}"
                                MouseEnter="GraphPopup_OnMouseEnter"
                                MouseLeave="GraphPopup_OnMouseLeave">
                    <StackPanel Margin="5.4,5.8,5.4,5.8"
                                Width="250">
                        <!-- The memory in use and how much of it that is, one line: 85% · 27.1 / 31.9 GB -->
                        <TextBlock x:Name="GraphHeader"
                                   Style="{DynamicResource GlobalFonts}"
                                   Foreground="{DynamicResource ButtonForeground}"
                                   FontFamily="Tahoma"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="2,0,2,0" />
                        <controls:RamGraph x:Name="Graph"
                                               Height="108"
                                               Margin="0,9,0,0" />
                        <!-- Min, average and max across the width of the widget: the first at the left, the last at the right, the
                             second between them. -->
                        <Grid Margin="2,6,2,0">
                            <TextBlock x:Name="GraphMin"
                                       HorizontalAlignment="Left"
                                       Style="{DynamicResource GlobalFonts}"
                                       Foreground="{DynamicResource ButtonForeground}"
                                       FontFamily="Microsoft Sans Serif"
                                       FontWeight="Normal" />
                            <TextBlock x:Name="GraphAverage"
                                       HorizontalAlignment="Center"
                                       Style="{DynamicResource GlobalFonts}"
                                       Foreground="{DynamicResource ButtonForeground}"
                                       FontFamily="Microsoft Sans Serif"
                                       FontWeight="Normal" />
                            <TextBlock x:Name="GraphMax"
                                       HorizontalAlignment="Right"
                                       Style="{DynamicResource GlobalFonts}"
                                       Foreground="{DynamicResource ButtonForeground}"
                                       FontFamily="Microsoft Sans Serif"
                                       FontWeight="Normal" />
                        </Grid>
                    </StackPanel>
                </ContentControl>
            </Grid>
        </Grid>
    </Popup>
    </Grid>
</UserControl>
