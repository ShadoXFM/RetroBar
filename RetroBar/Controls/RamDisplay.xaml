<UserControl x:Class="RetroBar.Controls.RamDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utilities="clr-namespace:RetroBar.Utilities"
             xmlns:controls="clr-namespace:RetroBar.Controls"
             Loaded="RamDisplay_OnLoaded"
             Unloaded="RamDisplay_OnUnloaded"
             Visibility="Collapsed">
    <Grid>
    <!-- Transparent background so the whole widget takes the pointer that opens the graph. -->
    <StackPanel x:Name="RamPanel"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Margin="4,0"
                Background="Transparent"
                MouseEnter="RamPanel_OnMouseEnter"
                MouseLeave="RamPanel_OnMouseLeave">
        <!-- A memory stick (a body with two chips and its pins), so the number reads as the memory's. It sits inside this same
             UserControl so it only ever appears alongside RamText. This is the 100% drawing, 10 by 8 pixels, each rectangle on a
             whole pixel. At 125% a DIP is 1.25 pixels, so there the RamChip tag in monitor-adjustments.json gives it a
             Width/Height and a Geometry drawn in 0.8 DIP units (12 by 9 pixels), which are whole pixels again. -->
        <Path x:Name="RamChip"
              Width="10"
              Height="8"
              Margin="-4,0,2,2"
              VerticalAlignment="Center"
              SnapsToDevicePixels="True"
              UseLayoutRounding="True"
              Fill="{DynamicResource ClockForeground}"
              Data="F1 M0,0 H10 V1 H0 Z M0,1 H1 V2 H0 Z M2,1 H4 V2 H2 Z M6,1 H8 V2 H6 Z M9,1 H10 V2 H9 Z M0,2 H1 V3 H0 Z M2,2 H4 V3 H2 Z M6,2 H8 V3 H6 Z M9,2 H10 V3 H9 Z M0,3 H1 V4 H0 Z M2,3 H4 V4 H2 Z M6,3 H8 V4 H6 Z M9,3 H10 V4 H9 Z M0,4 H1 V5 H0 Z M9,4 H10 V5 H9 Z M0,5 H10 V6 H0 Z M1,6 H2 V7 H1 Z M3,6 H4 V7 H3 Z M6,6 H7 V7 H6 Z M8,6 H9 V7 H8 Z M1,7 H2 V8 H1 Z M3,7 H4 V8 H3 Z M6,7 H7 V8 H6 Z M8,7 H9 V8 H8 Z"
              utilities:MonitorOffset.Tag="RamChip" />
        <TextBlock x:Name="RamText"
                   Style="{DynamicResource CpuTempStyle}"
                   Foreground="{DynamicResource ClockForeground}"
                   utilities:MonitorOffset.Tag="RamText" />
    </StackPanel>
    <!-- The graph of the memory in use over the last five minutes: opens and closes as the weather's forecast does (the same frame, the same
         slide; see RamDisplay.xaml.cs). -->
    <Popup x:Name="GraphPopup"
           StaysOpen="True"
           AllowsTransparency="True"
           PopupAnimation="None">
        <!-- Text on whole pixels, hinted as the graph's own labels are (the taskbar's smoothed text would blur the line of Min, Average
             and Max, which are laid out at the middle of the width, on half pixels). -->
        <Grid x:Name="GraphFrame"
              ClipToBounds="True"
              UseLayoutRounding="True"
              SnapsToDevicePixels="True"
              TextOptions.TextFormattingMode="Display"
              RenderOptions.ClearTypeHint="Enabled">
            <Grid x:Name="GraphSlideHost">
                <controls:PopupShadow />
                <ContentControl Margin="6"
                                Style="{DynamicResource TaskButtonThumbnail}"
                                MouseEnter="GraphPopup_OnMouseEnter"
                                MouseLeave="GraphPopup_OnMouseLeave">
                    <StackPanel Margin="5.4,5.8,5.4,5.8"
                                Width="250">
                        <!-- The memory in use and how much of it that is, one line: 85% · 27.1 / 31.9 GB -->
                        <TextBlock x:Name="GraphHeader"
                                   Style="{DynamicResource GlobalFonts}"
                                   Foreground="{DynamicResource ButtonForeground}"
                                   FontFamily="Tahoma"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="2,0,2,0" />
                        <controls:RamGraph x:Name="Graph"
                                               Height="108"
                                               Margin="0,9,0,0" />
                        <!-- Min, average and max across the width of the widget: the first at the left, the last at the right, the
                             second between them. -->
                        <Grid Margin="2,6,2,0">
                            <TextBlock x:Name="GraphMin"
                                       HorizontalAlignment="Left"
                                       Style="{DynamicResource GlobalFonts}"
                                       Foreground="{DynamicResource ButtonForeground}"
                                       FontFamily="Microsoft Sans Serif"
                                       FontWeight="Normal" />
                            <TextBlock x:Name="GraphAverage"
                                       HorizontalAlignment="Center"
                                       Style="{DynamicResource GlobalFonts}"
                                       Foreground="{DynamicResource ButtonForeground}"
                                       FontFamily="Microsoft Sans Serif"
                                       FontWeight="Normal" />
                            <TextBlock x:Name="GraphMax"
                                       HorizontalAlignment="Right"
                                       Style="{DynamicResource GlobalFonts}"
                                       Foreground="{DynamicResource ButtonForeground}"
                                       FontFamily="Microsoft Sans Serif"
                                       FontWeight="Normal" />
                        </Grid>
                    </StackPanel>
                </ContentControl>
            </Grid>
        </Grid>
    </Popup>
    </Grid>
</UserControl>
