<UserControl x:Class="RetroBar.Controls.TaskList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:local="clr-namespace:RetroBar.Controls"
             xmlns:converters="clr-namespace:RetroBar.Converters"
             xmlns:dd="urn:gong-wpf-dragdrop"
             xmlns:tasks="clr-namespace:ManagedShell.WindowsTasks;assembly=ManagedShell.WindowsTasks"
             xmlns:folders="clr-namespace:ManagedShell.ShellFolders;assembly=ManagedShell.ShellFolders"
             Loaded="TaskList_OnLoaded"
             Unloaded="TaskList_OnUnloaded"
             SizeChanged="TaskList_OnSizeChanged">
    <UserControl.Resources>
        <ResourceDictionary>
            <converters:DockOrientationConverter x:Key="dockOrientationConverter" />
            <converters:EdgeOrientationConverter x:Key="orientationConverter" />
            <converters:TaskButtonWidthConverter x:Key="taskButtonWidthConverter" />
            <!-- A tab (a window, the first of its app when windows are combined), and, in the Windows 11 style of the taskbar, the pinned program
                 that is not running (its icon, as the quick launch toolbar has it): see TaskList.Pinned.cs. -->
            <DataTemplate DataType="{x:Type tasks:ApplicationWindow}">
                <local:TaskButton Host="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:TaskList}}">
                    <local:TaskButton.Width>
                        <MultiBinding Converter="{StaticResource taskButtonWidthConverter}">
                                    <Binding Path="(ItemsControl.AlternationIndex)" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=ContentPresenter}" />
                                    <Binding Path="ButtonWidth" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=local:TaskList}" />
                                    <Binding Path="ExtraWidthCount" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=local:TaskList}" />
                                    <Binding Path="ButtonsPerRow" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=local:TaskList}" />
                                    <Binding Path="PixelStep" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=local:TaskList}" />
                                </MultiBinding>
                    </local:TaskButton.Width>
                </local:TaskButton>
            </DataTemplate>
            <DataTemplate DataType="{x:Type folders:ShellFile}">
                <local:ToolbarButton DataContext="{Binding}"
                                     Width="{Binding Path=LauncherWidth, RelativeSource={RelativeSource FindAncestor, AncestorType=local:TaskList}}"
                                     Margin="{Binding Path=LauncherMargin, RelativeSource={RelativeSource FindAncestor, AncestorType=local:TaskList}}"
                                     PreviewMouseLeftButtonUp="Launcher_OnPreviewMouseLeftButtonUp"
                                     PreviewMouseRightButtonUp="Launcher_OnPreviewMouseRightButtonUp" />
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel>
        <Thumb Style="{DynamicResource ToolbarThumb}">
            <DockPanel.Dock>
                <Binding Converter="{StaticResource dockOrientationConverter}"
                             ConverterParameter="leading"
                             Path="Orientation"
                             RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=Window}" />
            </DockPanel.Dock>
        </Thumb>
        <ScrollViewer Style="{DynamicResource TaskListScrollViewer}"
                      x:Name="TasksScrollViewer"
                      Focusable="False"
                      PreviewMouseWheel="TasksScrollViewer_PreviewMouseWheel"
                      VerticalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="TasksList"
                          Focusable="False"
                          HorizontalAlignment="Stretch"
                          dd:DragDrop.IsDragSource="True"
                          dd:DragDrop.IsDropTarget="True"
                          dd:DragDrop.DragDropContext="TaskList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- Transparent, not none: the gaps between the tabs are then part of the list, so a tab dragged over one is still over the list and keeps its drop mark. -->
                        <WrapPanel Style="{DynamicResource TaskListWrapPanel}" Background="Transparent">
                            <WrapPanel.Orientation>
                                <Binding Converter="{StaticResource orientationConverter}"
                                         Path="Orientation"
                                         RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=Window}" />
                            </WrapPanel.Orientation>
                        </WrapPanel>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
