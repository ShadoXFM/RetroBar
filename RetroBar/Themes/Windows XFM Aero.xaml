    <Style TargetType="ContentControl"
           x:Key="Taskbar"
           BasedOn="{StaticResource Taskbar}">
        <!-- On for everything in the bar (a property the content inherits from the control, not from the template): see the Grid below. -->
        <Setter Property="UseLayoutRounding"
                Value="True" />
        <Setter Property="SnapsToDevicePixels"
                Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <!-- Layout rounding is off for the taskbar at a scale like 125% (see Taskbar.SetLayoutRounding), which left what is drawn on
                         the bar on half pixels (soft glass, soft text): on for what is in the bar. -->
                    <Grid UseLayoutRounding="True"
                          SnapsToDevicePixels="True">
                        <Border x:Name="BarBackdrop" Background="#B80C0C0C" />
                        <utilities:NineSlice x:Name="BarGlass"
                                            Source="{StaticResource Win7TaskbarImage}"
                                            Margins="0,2,0,0" />
                        <!-- The sheen of Aero glass over the whole bar (behind what is on it): soft diagonal streaks of light, as on the glass of
                             Windows 7. -->
                        <Rectangle x:Name="BarSheen"
                                   IsHitTestVisible="False"
                                   Fill="{StaticResource TaskbarSheenBrush}" />
                        <ContentPresenter Name="Content" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- "Allow blur behind transparent taskbar" off: nothing is seen through the glass - what is behind it is black. -->
                        <DataTrigger Binding="{Binding Source={x:Static utilities:Settings.Instance}, Path=AllowBlurBehind}"
                                     Value="False">
                            <Setter TargetName="BarBackdrop"
                                    Property="Background"
                                    Value="Black" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                                     Value="Vertical">
                            <DataTrigger.Setters>
                                <Setter TargetName="BarSheen"
                                        Property="Visibility"
                                        Value="Collapsed" />
