<!--Windows XFM Aero by XFM: the Windows 7 taskbar (small icons) drawn with the pictures of Windows 7's own Aero style-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:utilities="clr-namespace:RetroBar.Utilities;assembly=RetroBar">

    <system:Double x:Key="TaskbarHeight">30</system:Double>
    <system:Double x:Key="TaskbarRowHeight">30</system:Double>
    <system:Double x:Key="TaskbarWidth">80</system:Double>
    <system:Boolean x:Key="AllowsTransparency">True</system:Boolean>
    <system:Boolean x:Key="UseFloatingStartButton">True</system:Boolean>
    <!-- The glass is the system's own blur-behind: no delay, as Windows 7's was. Its strength is not for a program to set, so the tint over it is dense,
         which keeps most of the blur from showing. -->
    <system:Boolean x:Key="AllowsBlurBehind">True</system:Boolean>
    <system:Int32 x:Key="BlurBehindKind">3</system:Int32>
    <system:Boolean x:Key="PopupShadowOutsideOnly">True</system:Boolean>
    <!-- The popups' shadow falls all round them (it is what sets the glass frames off) and is stronger. -->
    <system:Boolean x:Key="PopupShadowAllSides">True</system:Boolean>
    <system:Double x:Key="PopupShadowBoost">1.4</system:Double>
    <!-- A stronger and bigger shadow: a second one under the first, wider, and both spread 10 instead of 8. The rectangle that casts them reaches
         only half a DIP past the frame (3 left a thick black line round it). -->
    <system:Double x:Key="PopupShadowSpread">0.5</system:Double>
    <system:Double x:Key="PopupShadowBlur">10</system:Double>
    <system:Boolean x:Key="PopupShadowSecond">True</system:Boolean>
    <system:Boolean x:Key="PopupShadowKeepRoom">True</system:Boolean>
    <!-- A tab's frame is as tall as the bar's room for it: only a frame measured as tall is taken as the size of the tabs (see TaskList.PlausibleTabHeight). -->
    <system:Boolean x:Key="TaskFrameFillsBar">True</system:Boolean>    <system:Double x:Key="MediaPopupShadowStrength">0.75</system:Double>
    <!-- The popups' frames are blurred behind like the bar's glass (see PopupBlur). -->
    <system:Boolean x:Key="PopupBlurBehind">True</system:Boolean>
    <!-- The words of the media popup's lyrics have a faint shadow under them (see MediaPlayer.Lyrics.cs). -->
    <system:Boolean x:Key="MediaLyricsShadow">True</system:Boolean>
    <system:Double x:Key="MediaLyricsShadowOpacity">0.4</system:Double>
    <!-- The corners of the popups' frames (DIPs): the blur behind them is cut to the same. -->
    <system:Double x:Key="PopupBlurCornerRadius">6</system:Double>
    <Thickness x:Key="TaskButtonMargin" Right="1" />
    <FontWeight x:Key="SetTimeMenuItemWeight">Normal</FontWeight>

    <LinearGradientBrush x:Key="TaskbarBackground"
                         MappingMode="Absolute"
                         StartPoint="0,0"
                         EndPoint="0,26">
        <GradientStop Color="#a6a3a3a3"
                      Offset="0.0" />
        <GradientStop Color="#8f505050"
                      Offset="0.5" />
        <GradientStop Color="#66000000"
                      Offset="0.5" />
        <GradientStop Color="#70000000"
                      Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TaskbarVerticalBackground"
                         StartPoint="0,0"
                         EndPoint="1,0">
        <GradientStop Color="#cc939393"
                      Offset="0.0" />
        <GradientStop Color="#b5454545"
                      Offset="0.25" />
        <GradientStop Color="#97000000"
                      Offset="0.25" />
        <GradientStop Color="#a2000000"
                      Offset="1.0" />
    </LinearGradientBrush>
    <!-- The glass reflection Windows 7 draws over its glass (the picture of the reflection in aero.msstyles, 802 x 600, faint diagonal streaks), laid
         over the whole bar behind what is on it: tiled along the bar, at the middle of the picture. -->
    <BitmapImage x:Key="Win7ReflectionImage"
                 UriSource="../Resources/taskbar-reflection.png" />
    <ImageBrush x:Key="TaskbarSheenBrush"
                ImageSource="{StaticResource Win7ReflectionImage}"
                TileMode="Tile"
                Stretch="Fill"
                ViewportUnits="Absolute"
                Viewport="0,-283,1130,600" />
    <!-- The same reflection for a popup, which is not tiled: the bar is 40 tall and shows the middle of the picture, but a popup (the weather's
         forecast, the media popup) is taller than the 317 that the picture's tile has under the bar's offset, and the picture began again
         there, its streaks not meeting the ones above. From the top of the picture, which is 600 tall, and once. -->
    <ImageBrush x:Key="PopupSheenBrush"
                ImageSource="{StaticResource Win7ReflectionImage}"
                TileMode="None"
                Stretch="Fill"
                ViewportUnits="Absolute"
                Viewport="0,0,1130,600" />
    <!-- The tab previews have no blur window under them, as the widgets' popups have none (and their frame, see TaskButtonThumbnail). -->
    <system:Boolean x:Key="PreviewBlurBehind">False</system:Boolean>
    <!-- A soft dark glow behind the text, the icons and the lines of the popups (the widgets', the previews', the media popup's): they are drawn
         over glass, which is as light as what is behind it. One effect on a whole block of them, not one on each. -->
    <DropShadowEffect x:Key="PopupContentShadow"
                      BlurRadius="3.5"
                      ShadowDepth="0"
                      Opacity="0.92"
                      Color="Black" />
