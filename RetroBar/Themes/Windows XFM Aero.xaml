    <!-- The seek bar of the media popup: a dark groove with a light rim, and a glossy dark thumb with a light edge (the look of the menus'
         highlight), in place of the classic sunken groove and raised block. -->
    <Style TargetType="Thumb"
           x:Key="MediaSeekSliderThumbStyle"
           BasedOn="{StaticResource MediaSeekSliderThumbStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Width="10"
                            Height="16"
                            CornerRadius="3"
                            BorderThickness="1"
                            BorderBrush="#F0000000">
                        <Border x:Name="Gloss"
                                CornerRadius="2"
                                BorderThickness="1"
                                BorderBrush="#A0FFFFFF">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0"
                                                     EndPoint="0,1">
                                    <GradientStop Color="#8C8C8C"
                                                  Offset="0" />
                                    <GradientStop Color="#4A4A4A"
                                                  Offset="0.5" />
                                    <GradientStop Color="#1E1E1E"
                                                  Offset="0.5" />
                                    <GradientStop Color="#5A5A5A"
                                                  Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="Gloss"
                                    Property="BorderBrush"
                                    Value="#F0FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsDragging"
                                 Value="True">
                            <Setter TargetName="Gloss"
                                    Property="Opacity"
                                    Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- What has been played, in the groove: the same box as the groove (5 tall, in the same place, so the two come out on the same pixels at any scale)
         with the fill inside its border, one in from the top and the bottom, and a little in from the left, where the groove's end is rounded (from
         its very edge the fill stuck out of it). -->
    <Style TargetType="RepeatButton"
           x:Key="MediaSeekSliderProgressButtonStyle"
           BasedOn="{StaticResource MediaSeekSliderProgressButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent">
                        <Border VerticalAlignment="Center"
                                Height="5">
                            <!-- (From the groove's own border inwards, with its end's roundness: no black gap between the fill and the groove's end.) -->
                            <Border Margin="1,1,0,1"
                                    CornerRadius="1.5,0,0,1.5"
                                    Background="{DynamicResource MediaSeekProgress}" />
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider"
           x:Key="MediaSeekSliderStyle"
           BasedOn="{StaticResource MediaSeekSliderStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <Border VerticalAlignment="Center"
                                Height="5"
                                CornerRadius="2.5"
                                BorderThickness="1"
                                BorderBrush="#66FFFFFF"
                                Background="#B0000000" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource MediaSeekSliderProgressButtonStyle}"
                                              Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource MediaSeekSliderRepeatButtonStyle}"
                                              Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource MediaSeekSliderThumbStyle}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The close button on a thumbnail preview, with Windows 7's own pictures (aero.msstyles, TaskbandExtendedUI): the button's background
         (13 x 13, eight states one over the other: normal, under the pointer, pressed...) sliced by utilities:NineSlice with the margins the style
         gives it, and the X in the size for the monitor's scale. TaskButton.Preview.cs sizes the button and picks the X's picture
         (ScaleCloseGlyphToPixels); the state follows Tag ("hot" / "pressed", see TaskPreviewCloseButton in System.xaml). -->
    <Style TargetType="Button"
           x:Key="TaskPreviewCloseButton">
        <Setter Property="OverridesDefaultStyle"
                Value="True" />
        <Setter Property="Focusable"
                Value="False" />
        <Setter Property="Width"
                Value="14" />
        <Setter Property="Height"
                Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid UseLayoutRounding="True"
                          SnapsToDevicePixels="True">
                        <utilities:NineSlice x:Name="Face"
                                             Source="{StaticResource Win7ThumbCloseImage}"
                                             Margins="2,5,2,7"
                                             StateCount="8"
                                             State="0" />
                        <utilities:NineSlice x:Name="Win7Glyph"
                                             Margins="0"
                                             StateCount="8"
                                             State="0"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag"
                                 Value="hot">
                            <Setter TargetName="Face"
                                    Property="State"
                                    Value="1" />
                            <Setter TargetName="Win7Glyph"
                                    Property="State"
                                    Value="1" />
                        </Trigger>
                        <Trigger Property="Tag"
                                 Value="pressed">
                            <Setter TargetName="Face"
                                    Property="State"
                                    Value="2" />
                            <Setter TargetName="Win7Glyph"
                                    Property="State"
                                    Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The menus are drawn as Open Shell's Smoked Glass skin draws them: its own pictures (frame, highlight bar, separator), cut in the
         places its skin file says (Submenu_bitmap_slices, Main_selection_slices) and stretched between them. -->
    <!-- The frame of the tab previews, the widgets' popups and the media popup: the glass fill, the dark outline and the light line inside it,
         drawn with smooth corners in the picture (a Border with rounded corners drew them as steps), sliced by utilities:NineSlice with the
         corners kept in pixels. -->
    <BitmapImage x:Key="PopupFrameImage"
                 UriSource="../Resources/popupframe.png" />
    <!-- The same frame with a black fill (the media popup's; the others keep the grey one). -->
    <BitmapImage x:Key="MediaPopupFrameImage"
                 UriSource="../Resources/popupframe-black.png" />
    <!-- The push button of the visual style in use (aero10p1_seven.msstyles, Button / PushButton): six states one over the other (normal, hot,
         pressed, disabled, default, default pulsing), 40x26 each; drawn with utilities:NineSlice. -->
    <BitmapImage x:Key="Win7PushButtonImage"
                 UriSource="../Resources/win7-pushbutton.png" />
    <!-- The glass button of the same visual style that is used for what is under the pointer and what is chosen (the days of the clock's
         calendar): four states one over the other (normal, hot, pressed, disabled), 38x24 each. -->
    <BitmapImage x:Key="Win7GlassButtonImage"
                 UriSource="../Resources/win7-glassbutton.png" />
    <!-- The same frame, darker and nearly opaque: the glass of the popups that have no blur under them (attached to the taskbar, the widgets'). -->
    <BitmapImage x:Key="MediaPopupAttachedImage"
                 UriSource="../Resources/popupframe-attached.png" />
    <!-- The same with next to no fill: the glass of a popup that has the system's blur behind it (OpenGlass), which is all its glass is. -->
    <BitmapImage x:Key="GlassPopupFrameImage"
                 UriSource="../Resources/popupframe-glass.png" />
    <!-- The same, with the fill more see-through (a little over half as strong): the tab previews'. -->
    <BitmapImage x:Key="PreviewPopupFrameImage"
                 UriSource="../Resources/popupframe-preview.png" />
    <BitmapImage x:Key="MenuFrameImage"
                 UriSource="../Resources/xfmmenuframe.png" />
    <BitmapImage x:Key="MenuSelectionImage"
                 UriSource="../Resources/xfmmenuselect.png" />
    <Thickness x:Key="MenuSelectionMargins">4,4,4,4</Thickness>
    <Thickness x:Key="MenuSeparatorMargin">0</Thickness>
    <system:Double x:Key="MenuSeparatorFade">25</system:Double>
    <system:Double x:Key="MenuSeparatorHeight">8</system:Double>
    <SolidColorBrush x:Key="MenuSeparatorShadow" Color="#B1000000" />
    <SolidColorBrush x:Key="MenuSeparatorLight" Color="#4EFFFFFF" />
    <Style TargetType="ContentControl"
           x:Key="MenuFrame">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <!-- The picture's fill is a little clear (over the glass of Open Shell's menu, which is dark). -->
                        <Border Background="#F0080808"
                                CornerRadius="5"
                                Margin="1" />
                        <utilities:NineSlice Source="{DynamicResource MenuFrameImage}"
                                             Margins="13,13,13,13" />
                        <Border Padding="2.2,3.2">
                            <ContentPresenter />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <SolidColorBrush x:Key="MenuHighlightBrush" Color="Transparent" />
    <SolidColorBrush x:Key="MenuHighlightForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MenuHighlightBorder" Color="Transparent" />
    <Thickness x:Key="MenuItemBorderThickness">0</Thickness>
    <CornerRadius x:Key="MenuHighlightCornerRadius">0</CornerRadius>
    <Thickness x:Key="MenuItemTextMargin">0,2.3,10,2.3</Thickness>

    <Style TargetType="TextBlock"
           x:Key="MediaPlayerTrackTextStyle"
           BasedOn="{StaticResource MediaPlayerTrackTextStyle}">
        <Setter Property="FontSize"
                Value="{DynamicResource GlobalFontSize}" />
    </Style>

    <!-- The media player's buttons (on the bar and in its popup) are built as the buttons of a pinned program that is not running are: nothing
         at rest, the tab's glass under the pointer (faded in and out as the pins' is), no glass while pressed - the glyph goes a pixel down and
         right instead (PressShift). -->
    <Style TargetType="Button"
           x:Key="MediaPlayerButtonStyle"
           BasedOn="{StaticResource MediaPlayerButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent"
                            Padding="0,1,0,1"
                            Name="ButtonBorder">
                        <Grid>
                            <utilities:NineSlice x:Name="HoverGlass"
                                                Source="{StaticResource Win7TaskButtonImage}"
                                                Margins="3,3,3,3"
                                                StateCount="10"
                                                State="8"
                                                Opacity="0" />
                            <!-- The room the classic button has round its glyph (a pixel of border and of padding at the sides, its borders and
                                 3 of padding at the top and bottom): without it the buttons of the popup, which are as big as their glyph, were tight. -->
                            <ContentPresenter x:Name="Content"
                                              Margin="2,3,2,4"
                                              utilities:PressShift.Enabled="True"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- The glass is there while the pointer is over the button and it is not held: it goes when it is pressed, and comes back
                             when it is let go with the pointer still on it (a click on the pause button leaves the pointer there). -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver"
                                           Value="True" />
                                <Condition Property="IsPressed"
                                           Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverGlass"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverGlass"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <!-- (Pressed, the glyph goes exactly one device pixel down and right: see PressShift.) -->
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ContentControl"
           x:Key="MediaPopupFrame">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <utilities:NineSlice x:Name="Frame"
                                             Source="{DynamicResource MediaPopupFrameImage}"
                                             Crisp="True"
                                             Margins="8,8,8,8" />
                        <!-- The glass reflection of Windows 7 over the glass, as on the taskbar. -->
                        <Border x:Name="Sheen"
                                CornerRadius="6"
                                Margin="1"
                                IsHitTestVisible="False"
                                Background="{DynamicResource PopupSheenBrush}" />
                        <Border Padding="3,4">
                            <ContentPresenter />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Attached to the taskbar: no blur window under it, so the darker glass. -->
                        <Trigger Property="Tag" Value="Attached">
                            <Setter TargetName="Frame" Property="Source" Value="{DynamicResource MediaPopupAttachedImage}" />
                        </Trigger>
                        <!-- With the system's blur behind it (OpenGlass) the glass is that blur, with no black over it. -->
                        <DataTrigger Binding="{Binding Available, Source={x:Static utilities:DwmBlurState.Instance}}" Value="True">
                            <Setter TargetName="Frame" Property="Source" Value="{DynamicResource GlassPopupFrameImage}" />
                            <Setter TargetName="Sheen" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ContentControl"
           x:Key="TaskButtonThumbnail">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <!-- The room between the frame and what is in it: the widgets' popups have this, and the tab previews a little more (see TaskButton.xaml). -->
        <Setter Property="Padding" Value="5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid Margin="4">
                        <utilities:NineSlice x:Name="Frame"
                                             Source="{DynamicResource PopupFrameImage}"
                                             Crisp="True"
                                             Margins="8,8,8,8" />
                        <Border x:Name="Sheen"
                                CornerRadius="6"
                                Margin="1"
                                IsHitTestVisible="False"
                                Visibility="Collapsed"
                                Background="{DynamicResource PopupSheenBrush}" />
                        <Border x:Name="PreviewPadding" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- The widgets' popups (the weather's forecast, the graphs) have the media popup's frame; the tab previews keep this one. -->
                        <Trigger Property="Tag" Value="WidgetPopup">
                            <Setter TargetName="Frame" Property="Source" Value="{DynamicResource MediaPopupAttachedImage}" />
                            <Setter TargetName="Sheen" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Tag" Value="PreviewPopup">
                            <Setter TargetName="Frame" Property="Source" Value="{DynamicResource PreviewPopupFrameImage}" />
                            <Setter TargetName="Sheen" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <!-- With the blur made by the system (OpenGlass) behind the popup the frame is the see-through one, which is all the glass
                             there is, for the widgets' popups and the previews both (after them: it is the last that counts). -->
                        <DataTrigger Binding="{Binding Available, Source={x:Static utilities:DwmBlurState.Instance}}" Value="True">
                            <Setter TargetName="Frame" Property="Source" Value="{DynamicResource GlassPopupFrameImage}" />
                            <!-- (And no sheen of ours: the system's blur has the reflection of Windows 7 of its own, and with both the glass had
                                 two sets of streaks, which lit the corners differently.) -->
                            <Setter TargetName="Sheen" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TaskListScrollUpButton"
