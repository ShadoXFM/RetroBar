                Value="2,2,0,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <!-- SnapsToDevicePixels removed: this border is zero-thickness on
                         3 of 4 sides, the same shape that has the border-snapping bug
                         elsewhere in this app (see the other button templates). -->
                    <Border BorderThickness="1,0,0,0"
                            BorderBrush="{DynamicResource ButtonShadow}"
                            x:Name="OuterBorder1">
                        <Border BorderThickness="1,0,0,0"
                                BorderBrush="{DynamicResource ButtonHighlight}"
                                x:Name="OuterBorder2">
                            <Border BorderThickness="0,0,1,1"
                                    BorderBrush="{DynamicResource ButtonShadow}"
                                    HorizontalAlignment="Left"
                                    Margin="2,2,0,2"
                                    x:Name="OuterNub"
                                    Width="3">
                                <Border BorderThickness="1,1,0,0"
                                        BorderBrush="{DynamicResource ButtonHighlight}">
                                    
                                </Border>
                            </Border>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                                     Value="Vertical">
                            <DataTrigger.Setters>
                                <Setter TargetName="OuterBorder1"
                                        Property="BorderThickness"
                                        Value="0,1,0,0" />
                                <Setter TargetName="OuterBorder2"
                                        Property="BorderThickness"
                                        Value="0,1,0,0" />
