    <Style TargetType="StackPanel"
           x:Key="MediaPlayerPanelStyle">
        <Setter Property="Margin"
                Value="-1,0" />
        <Setter Property="Height"
                Value="{DynamicResource MediaPlayerRowHeight}" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
    </Style>

    <Style TargetType="Button"
           x:Key="MediaPlayerButtonStyle">
        <Setter Property="OverridesDefaultStyle"
                Value="True" />
        <Setter Property="Background"
                Value="{DynamicResource ButtonFace}" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <!-- Previously "1,-3,1,-2": negative top/bottom margins were used to stretch
             the button beyond its own content size to reach the row's height. That's
             fragile - the StackPanel sizes itself from the button's (margin-shrunk)
             DesiredSize, and how far the render then overflows that slot depends on
             exact fractional arithmetic that varies with DPI/rounding, which is what
             was pushing the buttons up out of the taskbar entirely. Now that
             MediaPlayerPanelStyle gives the whole row a fixed Height bound to
             TaskbarRowHeight, every child (buttons, album art, track text) can just
             use VerticalAlignment="Center" with a plain, non-negative Margin and they
             all land on the same centerline regardless of DPI. -->
        <Setter Property="Margin"
                Value="1,-2,1,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent"
                            UseLayoutRounding="True"
                            SnapsToDevicePixels="True"
                            Name="ButtonBorder">
                        <Border BorderThickness="0,0,1,1"
                                BorderBrush="{TemplateBinding Background}"
                                UseLayoutRounding="True"
                                SnapsToDevicePixels="True"
                                x:Name="ButtonRightBottomBorder">
                            <Border BorderThickness="1,1,0,0"
                                    BorderBrush="{TemplateBinding Background}"
                                    Background="{TemplateBinding Background}"
                                    Padding="2"
                                    UseLayoutRounding="True"
                                    SnapsToDevicePixels="True"
                                    x:Name="ButtonLeftTopBorder">
                                <ContentPresenter />
                            </Border>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                                     Value="Vertical">
                            <DataTrigger.Setters>
                                <Setter TargetName="ButtonBorder"
                                        Property="Padding"
                                        Value="0" />
                            </DataTrigger.Setters>
                        </DataTrigger>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="ButtonLeftTopBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource ButtonHighlight}" />
                            <Setter TargetName="ButtonRightBottomBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource ButtonShadow}" />
                        </Trigger>
                        <Trigger Property="IsPressed"
                                 Value="True">
                            <Setter TargetName="ButtonRightBottomBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource ButtonHighlight}" />
                            <Setter TargetName="ButtonLeftTopBorder"
                                    Property="BorderBrush"
                                    Value="{DynamicResource ButtonShadow}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=Orientation, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                         Value="Vertical">
                <Setter Property="Margin"
                        Value="0" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Media player transport glyphs are vector geometries rather than text.
         Text glyphs pick up per-font ink heights and per-monitor DPI rounding,
         which is why they used to sit at different heights on different displays.
         A fixed-height Path renders identically on every monitor. -->
    <system:Double x:Key="MediaPlayerGlyphHeight">7</system:Double>
    <!-- One shared width box for every transport glyph. The previous/next
         chevrons are drawn to fill this box exactly; the narrower play/pause
         glyphs sit centered inside it. That's what makes all three buttons the
         same size instead of each button hugging its own glyph's width. -->
    <system:Double x:Key="MediaPlayerGlyphWidth">10</system:Double>

    <PathGeometry x:Key="MediaPlayerPreviousGeometry"
                  Figures="M 4,0 L 4,7 L 0,3.5 Z M 9,0 L 9,7 L 5,3.5 Z" />
    <PathGeometry x:Key="MediaPlayerNextGeometry"
                  Figures="M 0,0 L 4,3.5 L 0,7 Z M 5,0 L 8.5,3.5 L 5,7 Z" />
    <PathGeometry x:Key="MediaPlayerPlayGeometry"
                  Figures="M 0,0 L 6,3.5 L 0,7 Z" />
    <PathGeometry x:Key="MediaPlayerPauseGeometry"
                  Figures="M 0,0 L 2,0 L 2,7 L 0,7 Z M 4,0 L 6,0 L 6,7 L 4,7 Z" />

    <!-- Shared base styles for every vector glyph in the shell chrome. Layout
         rounding puts the glyph's box on whole device pixels, which is what keeps
         it identical across monitors running different DPI scales. Crisp also
         turns off edge antialiasing, for themes whose arrows are meant to look
         like hand-placed pixels; Smooth keeps antialiasing for the Aero themes. -->
    <Style TargetType="Path"
           x:Key="SmoothGlyphPathStyle">
        <Setter Property="SnapsToDevicePixels"
                Value="True" />
        <Setter Property="UseLayoutRounding"
                Value="True" />
    </Style>

    <Style TargetType="Path"
           x:Key="CrispGlyphPathStyle"
           BasedOn="{StaticResource SmoothGlyphPathStyle}">
        <Setter Property="RenderOptions.EdgeMode"
                Value="Aliased" />
    </Style>

    <!-- The tray show/hide chevron, shared instead of repeated inline. -->
    <PathGeometry x:Key="TrayToggleChevronGeometry"
                  Figures="M 0,2.5 L 2,5 L 4.5,5 L 2,2.5 L 4.5,0 L 2,0 Z" />

    <Style TargetType="Path"
           x:Key="MediaPlayerGlyphStyle"
           BasedOn="{StaticResource CrispGlyphPathStyle}">
        <Setter Property="Width"
                Value="{DynamicResource MediaPlayerGlyphWidth}" />
        <Setter Property="Height"
                Value="{DynamicResource MediaPlayerGlyphHeight}" />
        <Setter Property="Stretch"
                Value="Uniform" />
        <Setter Property="HorizontalAlignment"
                Value="Center" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="Fill"
                Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
    </Style>

    <Style TargetType="Image"
           x:Key="MediaPlayerAlbumArtStyle">
        <Setter Property="Width"
                Value="16" />
        <Setter Property="Height"
                Value="16" />
        <Setter Property="Stretch"
                Value="UniformToFill" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <!-- 3px on the right (before the transport buttons) but 0 on the left
             left it sitting flush against the tray box's own inner edge -
             visibly unequal. 3px on both sides matches it. -->
        <Setter Property="Margin"
                Value="3,0,3,0" />
        <Setter Property="SnapsToDevicePixels"
                Value="True" />
        <Setter Property="UseLayoutRounding"
                Value="True" />
        <Setter Property="RenderOptions.BitmapScalingMode"
                Value="HighQuality" />
    </Style>

    <!-- Host clips the track text; the text itself is laid out at its full
         natural width inside it so the marquee can slide it back and forth. -->
    <Style TargetType="Grid"
           x:Key="MediaPlayerTrackTextHostStyle">
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="Margin"
                Value="4,-1,10,1" />
