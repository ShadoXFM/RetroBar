<!--Windows XFM by XFM | my music: zingbong.com-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:utilities="clr-namespace:RetroBar.Utilities;assembly=RetroBar">
    <system:Boolean x:Key="InvertSystemNotifyIcons">False</system:Boolean>
    <system:Double x:Key="TaskButtonWidth">120</system:Double>
    <system:Double x:Key="GlobalFontSize">10</system:Double>
    
 <!-- Dark Mode Colors -->
    <SolidColorBrush x:Key="ButtonHighlight" Color="#333333" />
    <SolidColorBrush x:Key="ButtonInnerHighlight" Color="#00000000" />
    <SolidColorBrush x:Key="ButtonLight" Color="#737373" />
    <SolidColorBrush x:Key="ButtonFace" Color="#121014" />
    <SolidColorBrush x:Key="ButtonShadow" Color="#0a0a0a" />
    <SolidColorBrush x:Key="ButtonDarkShadow" Color="#000000" />
    <SolidColorBrush x:Key="ButtonFlashingFace" Color="#3c159e" />

    <SolidColorBrush x:Key="ButtonForeground" Color="#d9d9d9" />
    <SolidColorBrush x:Key="ButtonFlashingForeground" Color="#d9d9d9" />
    <SolidColorBrush x:Key="ClockForeground" Color="#d9d9d9" />

    <SolidColorBrush x:Key="InputLanguageForeground" Color="#d9d9d9" />
    <SolidColorBrush x:Key="InputLanguageBackground" Color="#0A246A" />

    <SolidColorBrush x:Key="ToolTipBackground" Color="#212121" />
    <SolidColorBrush x:Key="ToolTipForeground" Color="#d9d9d9" />

    <!-- Styles -->
    <Style TargetType="TextBlock"
           x:Key="StartLabel"
           BasedOn="{StaticResource StartLabel}">
        <Setter Property="Margin"
                Value="-3,-1,1,0" />
    </Style>
    
    <Style TargetType="TextBlock"
           x:Key="Clock"
           BasedOn="{StaticResource Clock}">
        <Setter Property="Margin"
                Value="0,-1,6,0" />
        <Setter Property="FontFamily"
                Value="Tahoma" />
        <Setter Property="FontWeight"
                Value="Bold" />
    </Style>

    <Style TargetType="Thumb"
           x:Key="ToolbarThumb"
           BasedOn="{StaticResource ToolbarThumb}">
        <Setter Property="Margin"
                Value="3,2,0,2" />
    </Style>

    <Style TargetType="Rectangle" x:Key="WeatherIconStyle">
        <Setter Property="Width"
                Value="20" />
        <Setter Property="Height"
                Value="20" />
        <Setter Property="RenderOptions.BitmapScalingMode"
                Value="HighQuality" />
        <Setter Property="Margin"
                Value="-2,0,0,0" />
    </Style>

    <Style x:Key="WeatherTempStyle" TargetType="TextBlock" BasedOn="{StaticResource GlobalFonts}">
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="FontFamily"
                Value="Tahoma" />
        <Setter Property="FontWeight"
                Value="Bold" />
        <Setter Property="Margin"
                Value="2,-1,2,0" />
    </Style>

    <!-- Tray arrow replacement -->
    <Style TargetType="ToggleButton"
            x:Key="TrayToggleButton">
        <Setter Property="OverridesDefaultStyle"
                Value="True" />
        <Setter Property="Background"
                Value="{DynamicResource ButtonFace}" />
        <Setter Property="Margin"
                Value="-2,-3,7,-3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <!--
                        A single Border (content-driven size, same as before) with four 1px
                        Rectangles overlaid inside it for the bevel lines, instead of two nested
                        Borders each drawing a partial (top+left vs bottom+right) stroke. Nested
                        Borders each independently pixel-snap their own bounds based on their
                        parent's content-area inset, which at fractional DPI can round to a
                        physical pixel row/column that doesn't quite match its neighbor's -
                        producing exactly the kind of 1px corner overhang/gap this replaced. The
                        Rectangles live inside the SAME Border (sized by its own Padding+content,
                        not by their own Stretch alignment) so they can't inflate its bounds the
                        way they could as top-level Grid children with no fixed size to stretch
                        against.
                    -->
                    <Border x:Name="ButtonBorder"
                            Background="Transparent"
                            Padding="0,2"
                            utilities:MonitorOffset.Tag="TrayToggleButton"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <Grid Background="{TemplateBinding Background}">
                            <StackPanel Orientation="Horizontal"
                                        Height="12"
                                        VerticalAlignment="Center"
                                        Margin="4,0,4,-2"
                                        Name="ArrowPanel"
                                        utilities:MonitorOffset.Tag="TrayToggleButtonArrow">
                                <TextBlock Text="^"
                                        FontSize="12"
                                        FontFamily="Tahoma"
                                        Foreground="{DynamicResource ButtonForeground}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        RenderTransformOrigin="0.5,0.5"
                                        Name="ArrowText">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </StackPanel>
                            <Rectangle x:Name="TopLine"
                                       Height="1"
                                       VerticalAlignment="Top"
                                       Fill="{TemplateBinding Background}"
                                       SnapsToDevicePixels="True"
                                       utilities:MonitorOffset.Tag="TrayToggleButtonTop" />
                            <Rectangle x:Name="LeftLine"
                                       Width="1"
                                       HorizontalAlignment="Left"
                                       Fill="{TemplateBinding Background}"
                                       SnapsToDevicePixels="True"
                                       utilities:MonitorOffset.Tag="TrayToggleButtonLeft" />
                            <Rectangle x:Name="BottomLine"
                                       Height="1"
                                       VerticalAlignment="Bottom"
                                       Fill="{TemplateBinding Background}"
                                       SnapsToDevicePixels="True"
                                       utilities:MonitorOffset.Tag="TrayToggleButtonBottom" />
                            <Rectangle x:Name="RightLine"
                                       Width="1"
                                       HorizontalAlignment="Right"
                                       Fill="{TemplateBinding Background}"
                                       SnapsToDevicePixels="True"
                                       utilities:MonitorOffset.Tag="TrayToggleButtonRight" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Rotate arrow AND adjust only the text/panel position when open -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ArrowText" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" />
                                </Setter.Value>
                            </Setter>
                            <!-- Change this internal margin to shift/tweak spacing of just the arrow -->
                            <Setter TargetName="ArrowText" Property="Margin" Value="0,-3,0,4" />
                        </Trigger>

                        <Trigger Property="IsMouseOver"
                                Value="True">
                            <Setter TargetName="TopLine" Property="Fill" Value="{DynamicResource ButtonHighlight}" />
                            <Setter TargetName="LeftLine" Property="Fill" Value="{DynamicResource ButtonHighlight}" />
                            <Setter TargetName="BottomLine" Property="Fill" Value="{DynamicResource ButtonShadow}" />
                            <Setter TargetName="RightLine" Property="Fill" Value="{DynamicResource ButtonShadow}" />
                        </Trigger>
                        <Trigger Property="IsPressed"
                                Value="True">
                            <Setter TargetName="TopLine" Property="Fill" Value="{DynamicResource ButtonShadow}" />
                            <Setter TargetName="LeftLine" Property="Fill" Value="{DynamicResource ButtonShadow}" />
                            <Setter TargetName="BottomLine" Property="Fill" Value="{DynamicResource ButtonHighlight}" />
                            <Setter TargetName="RightLine" Property="Fill" Value="{DynamicResource ButtonHighlight}" />
                            <!-- Same content shift as TaskButton's IsPressed trigger, for the same "pushed in" 3D look. -->
                            <Setter TargetName="ArrowPanel" Property="Margin" Value="5,1,3,-3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="ToolTip" Value="{DynamicResource hide}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="False">
                <Setter Property="ToolTip" Value="{DynamicResource show_hidden}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Global Settings -->
    <FontFamily x:Key="GlobalFontFamily">Microsoft Sans Serif</FontFamily>

    <!-- Images -->
    <BitmapImage x:Key="ShowDesktopIconImageSmall"
                 UriSource="../Resources/desktopMe2k-sm.png" />
    <BitmapImage x:Key="ShowDesktopIconImageLarge"
                 UriSource="../Resources/desktopMe2k-lg.png" />
    <BitmapImage x:Key="StartIconImage"
                 UriSource="../Resources/startxpblue.png" />
</ResourceDictionary>