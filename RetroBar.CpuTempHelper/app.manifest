<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="RetroBar.CpuTempHelper"/>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!-- This process's entire purpose is reading CPU temperature sensors, which needs admin
             rights (the underlying library loads a kernel driver to read CPU MSRs) - unlike
             RetroBar.exe itself, which deliberately stays asInvoker (see RetroBar/app.manifest).
             Meant to be launched via Task Scheduler with "Run with highest privileges" so it
             elevates silently at logon instead of popping a UAC prompt. -->
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
